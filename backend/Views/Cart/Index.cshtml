@model CartIndexViewModel
@{
    ViewData["Title"] = "Your Cart";
    var returnUrl = Url.Action("Index", "Cart");
}
<main class="min-h-screen p-8 bg-background">
    <div class="max-w-4xl mx-auto">
        <h1 class="text-3xl font-bold text-foreground mb-8">Your Cart</h1>

        @if (!Model.Rows.Any())
        {
            <div class="rounded-2xl border border-border bg-card p-16 text-center">
                <p class="text-lg text-neutral-500 mb-6">Your cart is empty.</p>
                <a asp-controller="Products" asp-action="Index" class="inline-block rounded-full bg-primary-600 px-8 py-3 font-semibold text-white hover:bg-primary-700 transition">Browse Products</a>
            </div>
        }
        else
        {
            <div class="space-y-4 mb-8">
                @foreach (var row in Model.Rows)
                {
                    var product = row.Product;
                    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 rounded-2xl border border-border bg-card p-5 shadow-sm">
                        <a asp-controller="Products" asp-action="Details" asp-route-id="@row.Item.ProductId" class="h-20 w-20 shrink-0 overflow-hidden rounded-xl bg-neutral-100">
                            @if (!string.IsNullOrEmpty(product?.ImageUrl))
                            {
                                <img src="@product.ImageUrl" alt="@(product?.Name ?? row.Item.ProductName ?? "Product")" class="h-full w-full object-cover" />
                            }
                            else
                            {
                                <span class="flex h-full w-full items-center justify-center text-xs text-neutral-400">No image</span>
                            }
                        </a>
                        <div class="flex-1 min-w-0">
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@row.Item.ProductId" class="font-semibold text-foreground hover:text-primary-600">@(product?.Name ?? row.Item.ProductName ?? row.Item.ProductId)</a>
                            <p class="text-sm text-neutral-500">&#2547;@row.Item.UnitPriceSnapshot.ToString("0.##") each</p>
                        </div>
                        <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="flex items-center gap-2">
                            <input type="hidden" name="ItemId" value="@row.Item.ItemId" />
                            <input type="hidden" name="ReturnUrl" value="@returnUrl" />
                            <input type="number" name="Quantity" min="1" value="@row.Item.Quantity"
                                   class="w-16 rounded-lg border border-border px-2 py-1.5 text-center" />
                            <button type="submit" class="rounded-full border border-border px-3 py-1.5 text-sm font-semibold hover:border-neutral-400 transition">Update</button>
                        </form>
                        <form asp-controller="Cart" asp-action="Remove" method="post">
                            <input type="hidden" name="ItemId" value="@row.Item.ItemId" />
                            <input type="hidden" name="ReturnUrl" value="@returnUrl" />
                            <button type="submit" class="text-sm font-semibold text-danger-500 hover:text-danger-600 transition">Remove</button>
                        </form>
                    </div>
                }
            </div>

            <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
                <div class="flex items-center justify-between text-lg font-bold text-foreground mb-6">
                    <span>Total</span>
                    <span>&#2547;@Model.Total.ToString("0.##")</span>
                </div>
                @if (Model.IsSignedIn)
                {
                    <form asp-controller="Cart" asp-action="Checkout" method="post">
                        <button type="submit" class="w-full rounded-full bg-accent-500 px-6 py-3 font-bold text-white hover:bg-accent-600 transition">Checkout</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl"
                       class="block w-full rounded-full bg-primary-600 px-6 py-3 text-center font-bold text-white hover:bg-primary-700 transition">Sign in to checkout</a>
                }
            </div>
        }
    </div>
</main>
