@model CartIndexViewModel
@{
    ViewData["Title"] = "Your Cart";
    var returnUrl = Url.Action("Index", "Cart");
}
<main class="min-h-screen py-8 bg-background">
    <div class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8">
        <h1 class="text-3xl font-bold text-foreground mb-8">Your Cart</h1>

        @if (!Model.Rows.Any())
        {
            <div class="rounded-2xl border border-border bg-card p-16 text-center">
                <svg class="mx-auto h-14 w-14 text-neutral-300 mb-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                </svg>
                <p class="text-lg font-semibold text-foreground mb-1">Your cart is empty</p>
                <p class="text-sm text-neutral-500 mb-6">Looks like you haven't added anything yet.</p>
                <a asp-controller="Products" asp-action="Index" class="inline-block rounded-full bg-primary-600 px-8 py-3 font-semibold text-white hover:bg-primary-700 transition">Browse Products</a>
            </div>
        }
        else
        {
            <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_360px] items-start">
                <section aria-label="Shopping cart">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left min-w-[640px]">
                            <thead>
                                <tr class="border-b border-border text-xs uppercase tracking-widest text-neutral-500">
                                    <th class="py-3 pr-2 w-8"><span class="sr-only">Remove</span></th>
                                    <th class="py-3 pr-4 w-24"><span class="sr-only">Product image</span></th>
                                    <th class="py-3 pr-4">Product</th>
                                    <th class="py-3 pr-4">Price</th>
                                    <th class="py-3 pr-4 text-center">Quantity</th>
                                    <th class="py-3 pr-4 text-right">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-border align-middle">
                                @foreach (var row in Model.Rows)
                                {
                                    var product = row.Product;
                                    var lineTotal = row.Item.UnitPriceSnapshot * row.Item.Quantity;
                                    <tr>
                                        <td class="py-4 pr-2">
                                            <form asp-controller="Cart" asp-action="Remove" method="post">
                                                <input type="hidden" name="ItemId" value="@row.Item.ItemId" />
                                                <input type="hidden" name="ReturnUrl" value="@returnUrl" />
                                                <button type="submit" title="Remove @(product?.Name ?? row.Item.ProductName)"
                                                        class="flex h-8 w-8 items-center justify-center rounded-full text-xl leading-none text-neutral-400 hover:bg-neutral-100 hover:text-danger-500 transition">&times;</button>
                                            </form>
                                        </td>
                                        <td class="py-4 pr-4">
                                            <a asp-controller="Products" asp-action="Details" asp-route-id="@row.Item.ProductId"
                                               class="block h-16 w-16 overflow-hidden rounded-lg bg-neutral-100">
                                                @if (!string.IsNullOrEmpty(product?.ImageUrl))
                                                {
                                                    <img src="@product.ImageUrl" alt="@(product?.Name ?? row.Item.ProductName ?? "Product")" loading="lazy" class="h-full w-full object-cover" />
                                                }
                                                else
                                                {
                                                    <span class="flex h-full w-full items-center justify-center text-[10px] text-neutral-400">No image</span>
                                                }
                                            </a>
                                        </td>
                                        <td class="py-4 pr-4 max-w-[240px]">
                                            <a asp-controller="Products" asp-action="Details" asp-route-id="@row.Item.ProductId"
                                               class="font-semibold text-foreground hover:text-primary-600 transition">@(product?.Name ?? row.Item.ProductName ?? row.Item.ProductId)</a>
                                            <p class="text-xs text-neutral-500 mt-0.5">&#2547;@row.Item.UnitPriceSnapshot.ToString("0.##") each</p>
                                        </td>
                                        <td class="py-4 pr-4 text-neutral-600 whitespace-nowrap">&#2547;@row.Item.UnitPriceSnapshot.ToString("0.##")</td>
                                        <td class="py-4 pr-4">
                                            <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="qty-stepper flex justify-center" data-qty-form>
                                                <input type="hidden" name="ItemId" value="@row.Item.ItemId" />
                                                <input type="hidden" name="ReturnUrl" value="@returnUrl" />
                                                <label class="sr-only" for="qty-@row.Item.ItemId">Quantity</label>
                                                <div class="flex items-stretch rounded-lg border border-border overflow-hidden bg-card">
                                                    <button type="button" data-step="-1" aria-label="Decrease quantity"
                                                            class="w-9 h-9 flex items-center justify-center text-lg leading-none text-neutral-500 hover:bg-neutral-100 transition">&minus;</button>
                                                    <input id="qty-@row.Item.ItemId" type="number" name="Quantity" min="1" value="@row.Item.Quantity"
                                                           class="w-12 h-9 border-x border-border text-center text-sm bg-card outline-none focus:bg-neutral-50 transition" />
                                                    <button type="button" data-step="1" aria-label="Increase quantity"
                                                            class="w-9 h-9 flex items-center justify-center text-lg leading-none text-neutral-500 hover:bg-neutral-100 transition">+</button>
                                                </div>
                                            </form>
                                        </td>
                                        <td class="py-4 pr-4 text-right font-semibold whitespace-nowrap">&#2547;@lineTotal.ToString("0.##")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="mt-6 flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
                        <div>
                            <form class="flex gap-2" data-coupon-form>
                                <input type="text" name="CouponCode" placeholder="Coupon code" aria-label="Coupon code"
                                       class="w-48 rounded-full border border-border bg-card px-4 py-2 text-sm placeholder:text-neutral-400 focus:ring-2 focus:ring-primary-500 outline-none transition" />
                                <button type="button" class="rounded-full border border-border px-5 py-2 text-sm font-semibold hover:border-neutral-400 transition">Apply coupon</button>
                            </form>
                            <p data-coupon-hint class="hidden mt-2 text-xs text-neutral-500">
                                Coupons are redeemed with reward points from your <a asp-controller="Membership" asp-action="Index" class="underline underline-offset-2 hover:text-primary-600">Membership</a> page.
                            </p>
                        </div>
                        <button type="button" data-update-cart class="rounded-full border border-border px-6 py-2 text-sm font-semibold hover:border-neutral-400 transition">Update cart</button>
                    </div>
                </section>

                <aside class="rounded-2xl border border-border bg-card p-6 shadow-sm lg:sticky lg:top-28"
                       data-cart-totals data-subtotal="@Model.Total.ToString(System.Globalization.CultureInfo.InvariantCulture)" aria-label="Cart totals">
                    <h2 class="text-lg font-bold text-foreground pb-3 mb-1 border-b border-border">Cart Totals</h2>

                    <div class="flex items-center justify-between py-2.5 text-sm">
                        <span class="text-neutral-500">Subtotal</span>
                        <span class="font-semibold">&#2547;@Model.Total.ToString("0.##")</span>
                    </div>
                    <div class="flex items-center justify-between pb-2.5 text-sm">
                        <span class="text-neutral-500">Shipping</span>
                        <span data-shipping-label class="font-semibold text-success-600">Free</span>
                    </div>

                    <div class="py-2 border-t border-border">
                        <p class="text-sm font-semibold text-foreground mt-2 mb-2">Shipping</p>
                        <fieldset class="space-y-1 text-sm text-neutral-600">
                            <legend class="sr-only">Shipping options</legend>
                            <label class="flex items-center gap-2 py-1 cursor-pointer">
                                <input type="radio" name="ShippingOption" value="free" checked class="accent-primary-600" />
                                <span>Free shipping</span>
                            </label>
                            <label class="flex items-center gap-2 py-1 cursor-pointer">
                                <input type="radio" name="ShippingOption" value="flat" class="accent-primary-600" />
                                <span>Flat rate</span>
                            </label>
                            <label class="flex items-center gap-2 py-1 cursor-pointer">
                                <input type="radio" name="ShippingOption" value="pickup" class="accent-primary-600" />
                                <span>Local pickup</span>
                            </label>
                        </fieldset>
                        <button type="button" data-calc-toggle class="mt-3 text-sm text-neutral-500 underline underline-offset-2 hover:text-primary-600 transition">Calculate shipping</button>
                        <div data-calc-panel class="hidden mt-3">
                            <label class="sr-only" for="shipping-area">Postcode or delivery area</label>
                            <input id="shipping-area" type="text" placeholder="Postcode / delivery area"
                                   class="w-full rounded-xl border border-border px-4 py-2 text-sm focus:ring-2 focus:ring-primary-500 outline-none" />
                            <p class="mt-1.5 text-xs text-neutral-400">Rates shown are indicative; exact shipping is confirmed at checkout.</p>
                        </div>
                    </div>

                    <div class="border-t border-border mt-3 pt-5 flex items-center justify-between text-xl font-bold text-foreground">
                        <span>Total</span>
                        <span data-total-value>&#2547;@Model.Total.ToString("0.##")</span>
                    </div>

                    @if (Model.IsSignedIn)
                    {
                        <form asp-controller="Cart" asp-action="Checkout" method="post" class="mt-6">
                            <button type="submit" class="w-full rounded-full bg-neutral-900 px-6 py-3 font-bold text-white hover:bg-neutral-800 transition">Proceed to checkout</button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl"
                           class="block w-full rounded-full bg-neutral-900 px-6 py-3 mt-6 text-center font-bold text-white hover:bg-neutral-800 transition">Sign in to proceed to checkout</a>
                    }
                    <p class="mt-3 text-xs text-center text-neutral-400">Final total is confirmed at checkout.</p>
                </aside>
            </div>
        }
    </div>
</main>
