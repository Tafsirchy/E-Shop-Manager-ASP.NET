@model dynamic
@inject CurrentUser Me
@{
    var loginModel = new LoginViewModel();
    var registerModel = new RegisterViewModel();
}
<div id="auth-modal" class="fixed inset-0 z-[200] hidden items-center justify-center p-4" role="dialog" aria-modal="true" aria-hidden="true">
    <div id="auth-overlay" class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div>

    <div id="auth-panel" class="relative w-full max-w-md rounded-2xl border border-border bg-white shadow-2xl overflow-hidden">
        <button type="button" id="auth-close" class="absolute top-4 right-4 z-10 rounded-full p-2 text-neutral-400 hover:bg-neutral-100 hover:text-foreground transition-colors" aria-label="Close">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>

        <div id="auth-tabs" class="flex border-b border-border">
            <button type="button" data-auth-tab="login" class="auth-tab flex-1 py-4 text-sm font-bold uppercase tracking-wide border-b-2 transition-colors">Sign In</button>
            <button type="button" data-auth-tab="register" class="auth-tab flex-1 py-4 text-sm font-bold uppercase tracking-wide border-b-2 transition-colors">Sign Up</button>
        </div>

        <div class="p-6 sm:p-8">
            <div id="auth-msg" class="hidden mb-4 rounded-xl border-l-4 px-4 py-3 text-sm font-medium"></div>

            <!-- LOGIN PANEL -->
            <div id="auth-panel-login">
                <h2 class="text-xl font-bold text-foreground mb-1">Welcome back</h2>
                <p class="text-neutral-500 text-sm mb-6">Sign in to your E-Shop account.</p>
                <form asp-controller="Account" asp-action="Login" method="post" data-auth-form="login" class="space-y-5" novalidate>
                    <input type="hidden" name="ReturnUrl" />
                    <div>
                        <label class="block text-sm font-semibold text-foreground mb-2" for="login-email">Email</label>
                        <input id="login-email" name="Email" type="email" class="w-full rounded-xl border border-border px-4 py-3 focus:ring-2 focus:ring-primary-500 outline-none bg-white placeholder-neutral-400" placeholder="you@example.com" required />
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-foreground mb-2" for="login-password">Password</label>
                        <input id="login-password" name="Password" type="password" class="w-full rounded-xl border border-border px-4 py-3 focus:ring-2 focus:ring-primary-500 outline-none bg-white placeholder-neutral-400" placeholder="••••••••" required />
                    </div>
                    <button type="submit" class="w-full rounded-full border-2 border-foreground bg-foreground py-3 font-bold text-white transition-colors hover:bg-transparent hover:text-foreground">Sign In</button>
                </form>
            </div>

            <!-- REGISTER PANEL -->
            <div id="auth-panel-register" class="hidden">
                <h2 class="text-xl font-bold text-foreground mb-1">Create your account</h2>
                <p class="text-neutral-500 text-sm mb-6">Join E-Shop to track orders, earn rewards, and save your wishlist.</p>
                <form asp-controller="Account" asp-action="Register" method="post" data-auth-form="register" class="space-y-5" novalidate>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-semibold text-foreground mb-2" for="register-name">Full Name</label>
                            <input id="register-name" name="Name" type="text" class="w-full rounded-xl border border-border px-4 py-3 focus:ring-2 focus:ring-primary-500 outline-none bg-white placeholder-neutral-400" placeholder="Jane Doe" required />
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-foreground mb-2" for="register-email">Email</label>
                            <input id="register-email" name="Email" type="email" class="w-full rounded-xl border border-border px-4 py-3 focus:ring-2 focus:ring-primary-500 outline-none bg-white placeholder-neutral-400" placeholder="you@example.com" required />
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-semibold text-foreground mb-2" for="register-password">Password</label>
                            <input id="register-password" name="Password" type="password" class="w-full rounded-xl border border-border px-4 py-3 focus:ring-2 focus:ring-primary-500 outline-none bg-white placeholder-neutral-400" placeholder="At least 6 chars" required minlength="6" />
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-foreground mb-2" for="register-confirm">Confirm Password</label>
                            <input id="register-confirm" name="ConfirmPassword" type="password" class="w-full rounded-xl border border-border px-4 py-3 focus:ring-2 focus:ring-primary-500 outline-none bg-white placeholder-neutral-400" placeholder="Repeat password" required />
                        </div>
                    </div>
                    <button type="submit" class="w-full rounded-full border-2 border-foreground bg-foreground py-3 font-bold text-white transition-colors hover:bg-transparent hover:text-foreground">Create Account</button>
                </form>
            </div>
        </div>
    </div>
</div>
