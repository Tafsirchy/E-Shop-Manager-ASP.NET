@inject CurrentUser AdminMe
@{
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var statusMessage = TempData["StatusMessage"] as string;
    var statusIsError = TempData["StatusIsError"] as bool? ?? false;

    string NavClass(string name, string extra = "") =>
        (action.Equals(name, System.StringComparison.OrdinalIgnoreCase)
            ? "bg-white/10 text-white"
            : "text-neutral-400 hover:text-white hover:bg-white/5") + " " + extra;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " - Admin" : "Admin")</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-neutral-100 text-foreground font-sans antialiased">

    <div class="flex min-h-screen">

        <!-- ==================== ASIDE / SIDEBAR ==================== -->
        <aside class="fixed inset-y-0 left-0 z-40 flex w-64 flex-col bg-neutral-950 text-white">
            <div class="flex h-16 shrink-0 items-center gap-3 px-6">
                <img src="~/Asset/Logo.png" alt="E-Shop Logo" class="h-10 w-auto object-contain mix-blend-multiply invert" />
                <span class="text-xl font-black tracking-tight">Admin</span>
            </div>

            <nav class="flex-1 space-y-1 overflow-y-auto px-3 py-4 text-sm font-semibold">
                <p class="px-3 pb-2 text-[11px] font-bold uppercase tracking-widest text-neutral-500">Overview</p>
                <a asp-action="Index" class="flex items-center gap-3 rounded-xl px-3 py-2.5 transition @NavClass("Index")">
                    <span class="text-neutral-400">&#9632;</span> Dashboard
                </a>

                <p class="px-3 pb-2 pt-5 text-[11px] font-bold uppercase tracking-widest text-neutral-500">Catalog</p>
                <a asp-action="Products" class="flex items-center justify-between rounded-xl px-3 py-2.5 transition @NavClass("Products")">
                    <span class="flex items-center gap-3"><span class="text-neutral-400">&#9633;</span> Products</span>
                </a>
                <a asp-action="LowStock" class="flex items-center gap-3 rounded-xl px-3 py-2.5 transition @NavClass("LowStock")">
                    <span class="text-neutral-400">&#9888;</span> Low Stock
                </a>

                <p class="px-3 pb-2 pt-5 text-[11px] font-bold uppercase tracking-widest text-neutral-500">Commerce</p>
                <a asp-action="Orders" class="flex items-center gap-3 rounded-xl px-3 py-2.5 transition @NavClass("Orders")">
                    <span class="text-neutral-400">&#9776;</span> Orders
                </a>
                <a asp-action="Subscriptions" class="flex items-center gap-3 rounded-xl px-3 py-2.5 transition @NavClass("Subscriptions")">
                    <span class="text-neutral-400">&#9733;</span> Packages
                </a>

                <p class="px-3 pb-2 pt-5 text-[11px] font-bold uppercase tracking-widest text-neutral-500">Customers</p>
                <a asp-action="Users" class="flex items-center gap-3 rounded-xl px-3 py-2.5 transition @NavClass("Users")">
                    <span class="text-neutral-400">&#9679;</span> Users
                </a>

                <p class="px-3 pb-2 pt-5 text-[11px] font-bold uppercase tracking-widest text-neutral-500">Promotions</p>
                <a asp-action="Coupons" class="flex items-center gap-3 rounded-xl px-3 py-2.5 transition @NavClass("Coupons")">
                    <span class="text-neutral-400">&#9833;</span> Offers
                </a>
            </nav>

            <div class="border-t border-neutral-800 p-3 space-y-1 text-sm font-semibold">
                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-neutral-400 hover:bg-white/5 hover:text-white transition">
                    <span>&#8592;</span> View Store
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="w-full flex items-center gap-3 rounded-xl px-3 py-2.5 text-neutral-400 hover:bg-danger-500/10 hover:text-danger-400 transition">
                        <span>&#10005;</span> Sign Out
                    </button>
                </form>
            </div>
        </aside>
        <!-- ==================== /ASIDE ==================== -->

        <div class="flex-1 pl-64">
            <header class="sticky top-0 z-30 flex h-16 items-center justify-between border-b border-neutral-200 bg-white/90 px-8 backdrop-blur">
                <h1 class="text-lg font-bold text-foreground">@(ViewData["Title"] ?? "Admin")</h1>
                <div class="flex items-center gap-3 text-sm">
                    <a asp-controller="Home" asp-action="Index"
                       class="inline-flex items-center gap-2 rounded-full border-2 border-foreground px-4 py-1.5 font-semibold text-foreground transition-colors hover:bg-foreground hover:text-white">
                        <span>&#8962;</span> Go to Home
                    </a>
                    <span class="hidden md:inline text-neutral-500">Signed in as</span>
                    <span class="font-semibold">@(AdminMe.IsAuthenticated ? AdminMe.Name : "")</span>
                </div>
            </header>

            @if (!string.IsNullOrEmpty(statusMessage))
            {
                <div id="toast" class="fixed top-24 right-6 z-[100] max-w-sm animate-toast-in" role="alert">
                    <div class="flex items-start gap-3 rounded-xl border-l-4 px-4 py-3.5 shadow-lg backdrop-blur-sm @(statusIsError ? "border-l-danger-500 bg-danger-50 text-danger-700" : "border-l-success-500 bg-success-50 text-success-700")">
                        <span class="mt-0.5 flex-shrink-0 @(statusIsError ? "text-danger-500" : "text-success-500")">
                            @if (statusIsError)
                            {
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            }
                            else
                            {
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            }
                        </span>
                        <p class="flex-1 text-sm font-medium leading-snug">@statusMessage</p>
                        <button type="button" onclick="this.closest('#toast').remove()" class="flex-shrink-0 ml-1 rounded-lg p-1 hover:bg-black/5 transition-colors" aria-label="Dismiss">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                        </button>
                    </div>
                </div>
            }

            <main class="p-8">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
