@model Product
@{
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var inWishlist = ViewBag.InWishlist as bool? ?? false;
}
<div class="group relative bg-card rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 p-5 border border-border flex flex-col overflow-hidden">
    <div class="h-48 bg-gradient-to-br from-neutral-100 to-neutral-200 rounded-xl mb-4 flex items-center justify-center overflow-hidden relative">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id" class="absolute inset-0">
                <img src="@Model.ImageUrl" alt="@Model.Name" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" />
            </a>
        }
        else
        {
            <span class="text-neutral-400">No Image</span>
        }
        <div class="absolute top-2 right-2 z-20">
            <form asp-controller="Wishlist" asp-action="Toggle" method="post">
                <input type="hidden" name="ProductId" value="@Model.Id" />
                <input type="hidden" name="ReturnUrl" value="@returnUrl" />
                <button type="submit" aria-label="Toggle wishlist" title="Toggle wishlist"
                        class="flex h-9 w-9 items-center justify-center rounded-full bg-white/95 shadow-md transition hover:scale-110 @(inWishlist ? "text-danger-500" : "text-neutral-400")">
                    <svg class="w-5 h-5" fill="@(inWishlist ? "currentColor" : "none")" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
                </button>
            </form>
        </div>
    </div>

    <div class="flex items-start justify-between gap-3 mb-3">
        <div class="min-w-0">
            <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id" class="text-lg font-semibold text-foreground line-clamp-1 hover:text-primary-600">@Model.Name</a>
            <p class="text-sm text-neutral-500">@Model.Category</p>
        </div>
        <span class="text-lg font-bold text-foreground whitespace-nowrap">&#2547;@(Model.Price.ToString("0.##"))</span>
    </div>

    <div class="mt-auto flex items-center justify-between gap-3">
        <span class="text-sm font-medium px-2.5 py-1 rounded-full @(Model.Stock > 10 ? "bg-success-600/20 text-success-600" : Model.Stock > 0 ? "bg-warning-500/20 text-warning-500" : "bg-danger-500/20 text-danger-500")">
            @(Model.Stock > 0 ? $"{Model.Stock} in stock" : "Out of stock")
        </span>
        <form asp-controller="Cart" asp-action="Add" method="post">
            <input type="hidden" name="ProductId" value="@Model.Id" />
            <input type="hidden" name="Quantity" value="1" />
            <input type="hidden" name="ReturnUrl" value="@returnUrl" />
            <button type="submit" class="inline-flex items-center gap-2 rounded-full bg-accent-500 px-4 py-2 text-sm font-bold text-white transition-all duration-200 hover:bg-accent-600 hover:scale-105 disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:scale-100" @(Model.Stock <= 0 ? Html.Raw("disabled") : null)>
                Add to Cart
            </button>
        </form>
    </div>
</div>
