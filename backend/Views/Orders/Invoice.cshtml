@model InvoiceViewModel
@{
    ViewData["Title"] = "Invoice";
    var orderType = Model.Order switch
    {
        PremiumOrder => "Premium",
        BulkOrder => "Bulk",
        _ => "Regular"
    };
}
<main class="min-h-screen p-8 bg-background">
    <div class="max-w-2xl mx-auto">
        <div class="flex items-center justify-between mb-6 print:hidden">
            <a asp-controller="Orders" asp-action="Details" asp-route-id="@Model.Order.Id"
               class="text-primary-600 hover:text-primary-700 font-medium">&larr; Back to order</a>
            <button onclick="window.print()"
                    class="rounded-full bg-primary-600 px-6 py-2 font-semibold text-white hover:bg-primary-700 transition">
                Print / Save PDF
            </button>
        </div>

        <div class="rounded-2xl border border-border bg-card shadow-sm overflow-hidden">
            <div class="bg-neutral-950 text-white p-8 flex items-start justify-between">
                <div>
                    <p class="text-2xl font-bold tracking-tight">E&#8209;Shop Manager</p>
                    <p class="text-sm text-neutral-400 mt-1">Invoice for order #@Model.Order.Id</p>
                </div>
                <div class="text-right">
                    <span class="inline-block rounded-full bg-white/10 px-3 py-1 text-sm font-semibold">@orderType order</span>
                    <p class="mt-3 font-mono barcode-bg h-10 w-40 ml-auto opacity-80"></p>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-6 p-8 border-b border-border">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-neutral-500 mb-1">Billed to</p>
                    <p class="font-semibold text-foreground">@Model.CustomerName</p>
                    <p class="text-sm text-neutral-500">@Model.CustomerEmail</p>
                </div>
                <div class="text-right">
                    <p class="text-xs font-semibold uppercase tracking-wider text-neutral-500 mb-1">Details</p>
                    <p class="text-sm text-foreground">@Model.Order.CreatedAt.ToLocalTime().ToString("MMMM d, yyyy")</p>
                    <p class="text-sm mt-1">
                        <span class="rounded-full px-3 py-0.5 text-xs font-semibold @(Model.Order.Status switch
                            {
                                "Delivered" => "bg-success-500/15 text-success-600",
                                "Cancelled" => "bg-danger-500/15 text-danger-600",
                                "Pending" => "bg-warning-500/15 text-warning-500",
                                _ => "bg-primary-600/10 text-primary-700"
                            })">@Model.Order.Status</span>
                    </p>
                </div>
            </div>

            <table class="w-full text-left">
                <thead>
                    <tr class="border-b border-border text-xs uppercase tracking-wider text-neutral-500">
                        <th class="px-8 py-3 font-semibold">Item</th>
                        <th class="px-4 py-3 font-semibold text-center">Qty</th>
                        <th class="px-4 py-3 font-semibold text-right">Unit</th>
                        <th class="px-8 py-3 font-semibold text-right">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in Model.Lines)
                    {
                        <tr class="border-b border-border/60">
                            <td class="px-8 py-3">
                                <p class="font-medium text-foreground">@line.Name</p>
                                @if (!string.IsNullOrEmpty(line.Category))
                                {
                                    <p class="text-xs text-neutral-500 capitalize">@line.Category</p>
                                }
                            </td>
                            <td class="px-4 py-3 text-center text-neutral-600">@line.Quantity</td>
                            <td class="px-4 py-3 text-right text-neutral-600">&#2547;@line.UnitPrice.ToString("0.##")</td>
                            <td class="px-8 py-3 text-right font-medium text-foreground">&#2547;@line.LineTotal.ToString("0.##")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="p-8 flex flex-col items-end gap-1.5">
                <div class="flex justify-between w-64">
                    <span class="text-neutral-500">Subtotal</span>
                    <span class="text-foreground">&#2547;@Model.Order.Subtotal.ToString("0.##")</span>
                </div>
                <div class="flex justify-between w-64">
                    <span class="text-neutral-500">Category discounts</span>
                    <span class="text-success-600">-&#2547;@Model.Order.CategoryDiscountApplied.ToString("0.##")</span>
                </div>
                <div class="flex justify-between w-64">
                    <span class="text-neutral-500">@orderType order discount (@(Model.Order.Subtotal - Model.Order.CategoryDiscountApplied > 0
                        ? (Model.Order.DiscountApplied / (Model.Order.Subtotal - Model.Order.CategoryDiscountApplied) * 100m).ToString("0.#")
                        : "0")%)</span>
                    <span class="text-success-600">-&#2547;@Model.Order.DiscountApplied.ToString("0.##")</span>
                </div>
                <div class="flex justify-between w-64 border-t border-border pt-3 mt-2">
                    <span class="font-bold text-foreground">Total paid</span>
                    <span class="font-bold text-xl text-primary-700">&#2547;@Model.Order.TotalAmount.ToString("0.##")</span>
                </div>
            </div>

            <div class="bg-neutral-50 border-t border-border px-8 py-5 text-center">
                <p class="text-sm text-neutral-500">Thank you for shopping with E&#8209;Shop Manager!</p>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <style>
        @@media print {
            body * { visibility: hidden; }
            .rounded-2xl, .rounded-2xl * { visibility: visible; }
            .rounded-2xl { position: absolute; inset: 0 auto auto 0; width: 100%; border-radius: 0 !important; box-shadow: none !important; }
        }
    </style>
}
