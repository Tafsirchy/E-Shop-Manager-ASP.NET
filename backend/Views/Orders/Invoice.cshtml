@model InvoiceViewModel
@{
    ViewData["Title"] = "Invoice";
    var orderType = Model.Order switch
    {
        PremiumOrder => "Premium",
        BulkOrder => "Bulk",
        _ => "Regular"
    };
}
<main class="min-h-screen p-8 pt-24 bg-background">
    <div class="max-w-2xl mx-auto">
        <div class="flex items-center justify-between mb-6 print:hidden">
            <a asp-controller="Orders" asp-action="Details" asp-route-id="@Model.Order.Id"
               class="text-primary-600 hover:text-primary-700 font-medium">&larr; Back to order</a>
            <button type="button" id="download-pdf-btn"
                    class="rounded-full bg-primary-600 px-6 py-2 font-semibold text-white hover:bg-primary-700 transition">
                Download PDF
            </button>
        </div>

        <div id="invoice-card" class="rounded-2xl border border-border bg-card shadow-sm overflow-hidden">
            <div class="bg-neutral-950 text-white p-8 flex items-start justify-between">
                <div>
                    <p class="text-2xl font-bold tracking-tight">E&#8209;Shop Manager</p>
                    <p class="text-sm text-neutral-400 mt-1">Invoice for order #@Model.Order.Id</p>
                </div>
                <div class="text-right">
                    <span class="inline-block rounded-full bg-white/10 px-3 py-1 text-sm font-semibold">@orderType order</span>
                    <p class="mt-3 font-mono barcode-bg h-10 w-40 ml-auto opacity-80"></p>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-6 p-8 border-b border-border">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-neutral-500 mb-1">Billed to</p>
                    <p class="font-semibold text-foreground">@Model.CustomerName</p>
                    <p class="text-sm text-neutral-500">@Model.CustomerEmail</p>
                </div>
                <div class="text-right">
                    <p class="text-xs font-semibold uppercase tracking-wider text-neutral-500 mb-1">Details</p>
                    <p class="text-sm text-foreground">@Model.Order.CreatedAt.ToLocalTime().ToString("MMMM d, yyyy")</p>
                    <p class="text-sm mt-1">
                        <span class="rounded-full px-3 py-0.5 text-xs font-semibold @(Model.Order.Status switch
                            {
                                "Delivered" => "bg-success-500/15 text-success-600",
                                "Cancelled" => "bg-danger-500/15 text-danger-600",
                                "Pending" => "bg-warning-500/15 text-warning-500",
                                _ => "bg-primary-600/10 text-primary-700"
                            })">@Model.Order.Status</span>
                    </p>
                </div>
            </div>

            <table class="w-full text-left">
                <thead>
                    <tr class="border-b border-border text-xs uppercase tracking-wider text-neutral-500">
                        <th class="px-8 py-3 font-semibold">Item</th>
                        <th class="px-4 py-3 font-semibold text-center">Qty</th>
                        <th class="px-4 py-3 font-semibold text-right">Unit</th>
                        <th class="px-8 py-3 font-semibold text-right">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in Model.Lines)
                    {
                        <tr class="border-b border-border/60">
                            <td class="px-8 py-3">
                                <p class="font-medium text-foreground">@line.Name</p>
                                @if (!string.IsNullOrEmpty(line.Category))
                                {
                                    <p class="text-xs text-neutral-500 capitalize">@line.Category</p>
                                }
                            </td>
                            <td class="px-4 py-3 text-center text-neutral-600">@line.Quantity</td>
                            <td class="px-4 py-3 text-right text-neutral-600">&#2547;@line.UnitPrice.ToString("0.##")</td>
                            <td class="px-8 py-3 text-right font-medium text-foreground">&#2547;@line.LineTotal.ToString("0.##")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="p-8 flex flex-col items-end gap-1.5">
                <div class="flex justify-between w-64">
                    <span class="text-neutral-500">Subtotal</span>
                    <span class="text-foreground">&#2547;@Model.Order.Subtotal.ToString("0.##")</span>
                </div>
                <div class="flex justify-between w-64">
                    <span class="text-neutral-500">Category discounts</span>
                    <span class="text-success-600">-&#2547;@Model.Order.CategoryDiscountApplied.ToString("0.##")</span>
                </div>
                <div class="flex justify-between w-64">
                    <span class="text-neutral-500">@orderType order discount (@(Model.Order.Subtotal - Model.Order.CategoryDiscountApplied > 0
                        ? (Model.Order.DiscountApplied / (Model.Order.Subtotal - Model.Order.CategoryDiscountApplied) * 100m).ToString("0.#")
                        : "0")%)</span>
                    <span class="text-success-600">-&#2547;@Model.Order.DiscountApplied.ToString("0.##")</span>
                </div>
                <div class="flex justify-between w-64 border-t border-border pt-3 mt-2">
                    <span class="font-bold text-foreground">Total paid</span>
                    <span class="font-bold text-xl text-primary-700">&#2547;@Model.Order.TotalAmount.ToString("0.##")</span>
                </div>
            </div>

            <div class="bg-neutral-50 border-t border-border px-8 py-5 text-center">
                <p class="text-sm text-neutral-500">Thank you for shopping with E&#8209;Shop Manager!</p>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script src="~/lib/html2pdf.js/html2pdf.bundle.min.js" asp-append-version="true"></script>
    <style>
        @@media print {
            body * { visibility: hidden; }
            #invoice-card, #invoice-card * { visibility: visible; }
            #invoice-card { position: absolute; inset: 0 auto auto 0; width: 100%; border-radius: 0 !important; box-shadow: none !important; }
        }
    </style>
    <script>
        (function () {
            var btn = document.getElementById('download-pdf-btn');
            if (!btn || typeof html2pdf === 'undefined') return;

            function parseNum(s) {
                s = String(s).trim();
                var isPct = s.indexOf('%') !== -1;
                var n = parseFloat(s);
                if (isNaN(n)) return 0;
                return isPct ? n / 100 : n;
            }

            function to255(c) { return Math.max(0, Math.min(255, Math.round(c * 255))); }

            function clr(r, g, b, a) {
                return a >= 1
                    ? 'rgb(' + r + ', ' + g + ', ' + b + ')'
                    : 'rgba(' + r + ', ' + g + ', ' + b + ', ' + a + ')';
            }

            function oklabToRgb(L, a, b, alpha) {
                var l_ = L + 0.3963377774 * a + 0.2158037573 * b;
                var m_ = L - 0.1055613458 * a - 0.0638541728 * b;
                var s_ = L - 0.0894841775 * a - 1.2914855480 * b;
                var l = l_ * l_ * l_, m = m_ * m_ * m_, s = s_ * s_ * s_;
                var r = 4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s;
                var g = -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s;
                var bl = -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s;
                var enc = function (c) {
                    c = c <= 0.0031308 ? 12.92 * c : 1.055 * Math.pow(c, 1 / 2.4) - 0.055;
                    return to255(c);
                };
                return clr(enc(r), enc(g), enc(bl), alpha);
            }

            function splitArgs(inner) {
                var parts = inner.trim().split(/\s+/);
                var nums = [], alpha = 1, slash = false;
                for (var i = 0; i < parts.length; i++) {
                    var p = parts[i];
                    if (p === '/') { slash = true; continue; }
                    if (/[0-9]/.test(p)) {
                        if (slash) alpha = parseNum(p);
                        else if (nums.length < 3) nums.push(parseNum(p));
                    }
                }
                return { nums: nums, alpha: alpha };
            }

            function convert(str) {
                if (!str) return str;
                str = str.replace(/oklch\s*\(([^)]*)\)/gi, function (m, inner) {
                    var x = splitArgs(inner);
                    var C = x.nums[1] || 0, H = x.nums[2] || 0;
                    var a = C * Math.cos(H * Math.PI / 180);
                    var b = C * Math.sin(H * Math.PI / 180);
                    return oklabToRgb(x.nums[0] || 0, a, b, x.alpha);
                });
                str = str.replace(/oklab\s*\(([^)]*)\)/gi, function (m, inner) {
                    var x = splitArgs(inner);
                    return oklabToRgb(x.nums[0] || 0, x.nums[1] || 0, x.nums[2] || 0, x.alpha);
                });
                str = str.replace(/color\(\s*srgb\s+([^)]*)\)/gi, function (m, inner) {
                    var x = splitArgs(inner);
                    return clr(to255(x.nums[0] || 0), to255(x.nums[1] || 0), to255(x.nums[2] || 0), x.alpha);
                });
                return str;
            }

            var PROPS = [
                ['color', 'color'],
                ['backgroundColor', 'background-color'],
                ['borderTopColor', 'border-top-color'],
                ['borderRightColor', 'border-right-color'],
                ['borderBottomColor', 'border-bottom-color'],
                ['borderLeftColor', 'border-left-color'],
                ['outlineColor', 'outline-color'],
                ['textDecorationColor', 'text-decoration-color'],
                ['caretColor', 'caret-color'],
                ['columnRuleColor', 'column-rule-color'],
                ['boxShadow', 'box-shadow'],
                ['textShadow', 'text-shadow'],
                ['fill', 'fill'],
                ['stroke', 'stroke']
            ];

            function walk(el) {
                PROPS.forEach(function (p) {
                    var raw = window.getComputedStyle(el).getPropertyValue(p[1]);
                    var c = convert(raw);
                    if (c !== raw) { try { el.style[p[0]] = c; } catch (e) { } }
                });
                for (var i = 0; i < el.children.length; i++) walk(el.children[i]);
            }

            btn.addEventListener('click', function () {
                var original = btn.textContent;
                btn.disabled = true;
                btn.textContent = 'Generating\u2026';

                function normalizeInClone(clonedDoc) {
                    var card = clonedDoc.getElementById('invoice-card');
                    if (card) {
                        card.style.borderRadius = '0';
                        card.style.boxShadow = 'none';
                        walk(card);
                    }
                }

                html2pdf().set({
                    margin: 10,
                    filename: 'Invoice-' + '@Model.Order.Id' + '.pdf',
                    image: { type: 'jpeg', quality: 0.98 },
                    html2canvas: {
                        scale: 2,
                        useCORS: true,
                        backgroundColor: '#ffffff',
                        onclone: normalizeInClone,
                        windowWidth: document.documentElement.scrollWidth,
                        windowHeight: document.documentElement.scrollHeight
                    },
                    jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
                    pagebreak: { mode: ['css', 'legacy'] }
                }).from(document.getElementById('invoice-card')).save().then(function () {
                    btn.disabled = false;
                    btn.textContent = original;
                }).catch(function (err) {
                    console.error('PDF generation failed:', err);
                    alert('Could not generate the PDF. Please try the print option instead.');
                    btn.disabled = false;
                    btn.textContent = original;
                });
            });
        })();
    </script>
}
