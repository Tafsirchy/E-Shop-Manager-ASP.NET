@model OrderDetailsViewModel
@{
    ViewData["Title"] = "Order Details";
    var order = Model.Order;
    var statusColors = new Dictionary<string, string>
    {
        ["Pending"]    = "bg-warning-500/15 text-warning-500",
        ["Processing"] = "bg-primary-600/10 text-primary-700",
        ["Shipped"]    = "bg-info-500/15 text-info-600",
        ["Delivered"]  = "bg-success-500/15 text-success-600",
        ["Cancelled"]  = "bg-danger-500/15 text-danger-600"
    };
    var dotColors = new Dictionary<string, string>
    {
        ["Pending"]    = "bg-warning-500",
        ["Processing"] = "bg-primary-600",
        ["Shipped"]    = "bg-info-500",
        ["Delivered"]  = "bg-success-500",
        ["Cancelled"]  = "bg-danger-600"
    };
}
<main class="min-h-screen p-8 bg-background">
    <div class="max-w-3xl mx-auto">
        <nav class="text-sm text-neutral-500 mb-6">
            <a asp-controller="Orders" asp-action="Index" class="hover:text-primary-600">&larr; Back to Orders</a>
        </nav>

        <div class="rounded-2xl border border-border bg-card p-8 shadow-sm mb-6">
            <div class="flex flex-wrap items-center justify-between gap-4 mb-6 pb-6 border-b border-border">
                <div>
                    <h1 class="text-xl font-bold text-foreground font-mono">#@order.Id</h1>
                    <p class="text-sm text-neutral-500 mt-1">Placed @order.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</p>
                </div>
                <span class="rounded-full px-4 py-1.5 text-sm font-semibold @(statusColors.GetValueOrDefault(order.Status, "bg-neutral-100 text-neutral-600"))">@order.Status</span>
            </div>

            @if (!string.IsNullOrWhiteSpace(order.TrackingNumber))
            {
                <div class="mb-6 p-4 rounded-xl bg-primary-600/5 border border-primary-600/20 flex items-center justify-between gap-4">
                    <div>
                        <p class="text-xs font-semibold text-primary-700 uppercase tracking-wide mb-1">Tracking Number</p>
                        <p class="font-mono text-sm text-foreground tracking-wide" id="tracking-code">@order.TrackingNumber</p>
                    </div>
                    <button type="button" onclick="copyTracking()" class="shrink-0 rounded-lg bg-primary-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-primary-700 transition" id="copy-btn">Copy</button>
                </div>
            }

            <div class="space-y-4 mb-6">
                @foreach (var item in order.Items)
                {
                    <div class="flex items-center justify-between gap-4">
                        <div>
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId" class="font-semibold text-foreground hover:text-primary-600">@(item.ProductName ?? item.ProductId)</a>
                            <p class="text-sm text-neutral-500">&#2547;@item.UnitPriceSnapshot.ToString("0.##") &times; @item.Quantity</p>
                        </div>
                        <span class="font-semibold text-foreground">&#2547;@((item.UnitPriceSnapshot * item.Quantity).ToString("0.##"))</span>
                    </div>
                }
            </div>

            <div class="border-t border-border pt-4 space-y-2 text-right">
                @if (order.CategoryDiscountApplied > 0)
                {
                    <p class="text-sm text-success-600">Category discounts: -&#2547;@order.CategoryDiscountApplied.ToString("0.##")</p>
                }
                @if (order.DiscountApplied > 0)
                {
                    <p class="text-sm text-success-600">@Model.Order switch { PremiumOrder => "Premium", BulkOrder => "Bulk", _ => "Order-type" } discount: -&#2547;@order.DiscountApplied.ToString("0.##")</p>
                }
                <p class="text-lg font-bold text-foreground">Total: &#2547;@order.TotalAmount.ToString("0.##")</p>
            </div>
        </div>

        @if (Model.History.Count > 0)
        {
            <div class="rounded-2xl border border-border bg-card p-8 shadow-sm mb-6">
                <h2 class="text-sm font-bold text-foreground uppercase tracking-wide mb-6">Order Tracking</h2>
                <div class="relative">
                    <div class="absolute left-[11px] top-3 bottom-3 w-px bg-border"></div>
                    <div class="space-y-6">
                        @for (var i = Model.History.Count - 1; i >= 0; i--)
                        {
                            var entry = Model.History[i];
                            var isLatest = i == Model.History.Count - 1;
                            var dotColor = dotColors.GetValueOrDefault(entry.Status, "bg-neutral-400");
                            <div class="relative flex items-start gap-4 pl-0">
                                <div class="relative z-10 mt-1 flex items-center justify-center @(isLatest ? "w-6 h-6" : "w-3 h-3")">
                                    <span class="block rounded-full @(dotColor) @(isLatest ? "w-6 h-6 ring-4 ring-primary-500/20" : "w-3 h-3")"></span>
                                </div>
                                <div class="flex-1 min-w-0 @(isLatest ? "" : "opacity-75")">
                                    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                                        <span class="font-semibold text-foreground @(isLatest ? "text-base" : "text-sm")">@entry.Status</span>
                                        <span class="text-xs text-neutral-400">@entry.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(entry.Note))
                                    {
                                        <p class="text-sm text-neutral-500 mt-0.5">@entry.Note</p>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (Model.IsAdmin)
        {
            <div class="rounded-2xl border border-border bg-card p-8 shadow-sm mb-6">
                <h2 class="text-sm font-bold text-foreground uppercase tracking-wide mb-4">Admin Actions</h2>
                <form asp-controller="Orders" asp-action="UpdateStatus" method="post" class="space-y-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="@order.Id" />

                    <div>
                        <label for="Status" class="block text-sm font-medium text-foreground mb-1">Update Status</label>
                        <select name="Status" id="Status"
                                class="w-full rounded-lg border border-border bg-background px-3 py-2 text-sm text-foreground focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
                            @foreach (var s in new[] { "Pending", "Processing", "Shipped", "Delivered", "Cancelled" })
                            {
                                <option value="@s" selected="@(s == order.Status)">@s</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label for="TrackingNumber" class="block text-sm font-medium text-foreground mb-1">Tracking Number <span class="text-neutral-400 font-normal">(optional)</span></label>
                        <input type="text" name="TrackingNumber" id="TrackingNumber" value="@order.TrackingNumber"
                               placeholder="e.g. BD-TRK-1234567"
                               class="w-full rounded-lg border border-border bg-background px-3 py-2 text-sm text-foreground placeholder:text-neutral-400 focus:ring-2 focus:ring-primary-500 focus:border-primary-500" />
                    </div>

                    <div>
                        <label for="Note" class="block text-sm font-medium text-foreground mb-1">Note <span class="text-neutral-400 font-normal">(optional)</span></label>
                        <textarea name="Note" id="Note" rows="2"
                                  placeholder="Internal note for this status change..."
                                  class="w-full rounded-lg border border-border bg-background px-3 py-2 text-sm text-foreground placeholder:text-neutral-400 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 resize-none"></textarea>
                    </div>

                    <button type="submit"
                            class="rounded-full bg-primary-600 px-6 py-2 text-sm font-semibold text-white hover:bg-primary-700 transition">
                        Update Order
                    </button>
                </form>
            </div>
        }

        <div class="flex justify-end print:hidden">
            <a asp-controller="Orders" asp-action="Invoice" asp-route-id="@order.Id"
               class="inline-block rounded-full bg-primary-600 px-6 py-2 font-semibold text-white hover:bg-primary-700 transition">
                View Invoice
            </a>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        function copyTracking() {
            var code = document.getElementById('tracking-code');
            var btn = document.getElementById('copy-btn');
            if (!code) return;
            navigator.clipboard.writeText(code.textContent.trim()).then(function() {
                btn.textContent = 'Copied!';
                btn.classList.add('bg-success-500');
                setTimeout(function() {
                    btn.textContent = 'Copy';
                    btn.classList.remove('bg-success-500');
                }, 1500);
            });
        }
    </script>
}
