@model HomeIndexViewModel
@{
    ViewData["Title"] = "Home";
    var heroImages = new[]
    {
        "https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&q=80&w=600",
        "https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&q=80&w=600",
        "https://images.unsplash.com/photo-1539109136881-3be0616acf4b?auto=format&fit=crop&q=80&w=600",
        "https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&fit=crop&q=80&w=600",
        "https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&q=80&w=600",
        "https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&q=80&w=600",
        "https://images.unsplash.com/photo-1617137968427-85924c800a22?auto=format&fit=crop&q=80&w=600"
    };
    var trustItems = new[]
    {
        ("FAST DELIVERY", "Within 48 hours"),
        ("SECURE PAYMENTS", "100% Safe Checkout"),
        ("EASY RETURNS", "7-Day Policy"),
        ("24/7 SUPPORT", "Always here for you"),
        ("PREMIUM QUALITY", "Guaranteed")
    };
    var categories = new[]
    {
        new[] { "COLLECTION", "", "font-black", "text-[14vw] lg:text-[10rem]", "text-left", "https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&q=80&w=1000" },
        new[] { "AVANT-GARDE", "Avant-Garde", "font-bold", "text-[8vw] lg:text-[5rem]", "text-center", "https://images.unsplash.com/photo-1509631179647-0177331693ae?auto=format&fit=crop&q=80&w=1000" },
        new[] { "FASHION NOW", "", "font-black", "text-[10vw] lg:text-[7rem]", "text-right", "https://images.unsplash.com/photo-1445205170230-053b83016050?auto=format&fit=crop&q=80&w=1000" },
        new[] { "SHOP NOW", "", "font-black", "text-[15vw] lg:text-[11rem]", "text-left", "https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&q=80&w=1000" },
        new[] { "IDENTITY", "", "font-extrabold", "text-[9vw] lg:text-[6.5rem]", "text-center", "https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&fit=crop&q=80&w=1000" },
        new[] { "FW24", "", "font-black", "text-[12vw] lg:text-[8rem]", "text-right", "https://images.unsplash.com/photo-1523206489230-c012c64b2b48?auto=format&fit=crop&q=80&w=1000" }
    };
    var flashProducts = Model.NewArrivals.Take(6).ToList();
}

<main class="min-h-screen bg-white">

    <!-- ======================= HERO ======================= -->
    <section class="pt-4 pb-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">

        <!-- HEADLINE ROW -->
        <div class="flex flex-col md:flex-row items-center justify-between mb-8 sm:mb-10 gap-8">

            <!-- Left: Rotating Badge -->
            <div class="hidden md:flex items-center justify-center relative w-32 h-32 flex-shrink-0">
                <div class="absolute inset-0 animate-[spin_15s_linear_infinite]">
                    <svg viewBox="0 0 100 100" class="w-full h-full overflow-visible">
                        <path id="circlePath" d="M 50, 50 m -35, 0 a 35,35 0 1,1 70,0 a 35,35 0 1,1 -70,0" fill="transparent" />
                        <text class="text-[10.5px] font-bold tracking-[0.15em] uppercase fill-neutral-800">
                            <textPath href="#circlePath" startOffset="0%">
                                Discover our premium products •
                            </textPath>
                        </text>
                    </svg>
                </div>
                <button type="button" class="relative z-10 w-12 h-12 bg-neutral-900 rounded-full flex items-center justify-center text-white hover:scale-110 transition-transform">
                    <svg class="w-4 h-4 ml-1" fill="currentColor" viewBox="0 0 20 20"><path d="M4 4l12 6-12 6z"></path></svg>
                </button>
            </div>

            <!-- Center: Headline -->
            <div class="flex-1 text-center">
                <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-[56px] font-black tracking-tight leading-[1.1] text-neutral-900">
                    Curated Goods. <br /> Seamless Shopping.
                </h1>
            </div>

            <!-- Right: Avatars -->
            <div class="hidden md:flex items-center justify-end w-32 flex-shrink-0">
                <div class="flex -space-x-3">
                    <div class="w-10 h-10 rounded-full bg-blue-500 border-2 border-white flex items-center justify-center text-white text-lg overflow-hidden shadow-sm">&#128104;&#8205;&#129490;</div>
                    <div class="w-10 h-10 rounded-full bg-purple-500 border-2 border-white flex items-center justify-center text-white text-lg overflow-hidden shadow-sm">&#128105;&#127995;</div>
                    <div class="w-10 h-10 rounded-full bg-pink-500 border-2 border-white flex items-center justify-center text-white text-lg overflow-hidden shadow-sm">&#128104;&#127998;</div>
                    <div class="w-10 h-10 rounded-full bg-neutral-900 border-2 border-white flex items-center justify-center text-white text-sm font-bold z-10 shadow-sm">+</div>
                </div>
            </div>

        </div>

        <!-- MULTI-COLUMN IMAGE GALLERY -->
        <div class="relative" id="hero-gallery">

            <!-- Decorative Sparkle -->
            <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 z-20 text-orange-400 text-3xl hidden lg:flex items-center justify-center">
                <svg class="w-10 h-10 animate-[spin_10s_linear_infinite]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M12 3v18m9-9H3m15.364-6.364l-12.728 12.728m12.728 0L5.636 5.636" stroke-linecap="round"/></svg>
            </div>

            <!-- Desktop/Tablet Grid -->
            <div class="hidden md:grid grid-cols-3 lg:grid-cols-5 gap-4 lg:gap-5 h-[450px] lg:h-[500px]">

                <!-- Column 1 -->
                <div class="flex flex-col gap-4 lg:gap-5 h-full pt-6">
                    <div class="flex-1 rounded-t-[2.5rem] rounded-b-2xl overflow-hidden relative group shadow-sm hover:shadow-md transition-shadow">
                        <div class="hero-slot absolute inset-0 transition-all duration-700 ease-in-out opacity-100 scale-100 blur-0" data-slot="0">
                            <img src="@heroImages[0]" alt="Gallery Item" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
                        </div>
                        <div class="absolute inset-0 bg-black/5 group-hover:bg-transparent transition-colors duration-500"></div>
                    </div>
                    <div class="h-32 rounded-t-[2rem] rounded-b-2xl overflow-hidden relative group shadow-sm hover:shadow-md transition-shadow">
                        <div class="hero-slot absolute inset-0 transition-all duration-700 ease-in-out opacity-100 scale-100 blur-0" data-slot="1">
                            <img src="@heroImages[1]" alt="Gallery Item" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
                        </div>
                        <div class="absolute inset-0 bg-black/5 group-hover:bg-transparent transition-colors duration-500"></div>
                    </div>
                </div>

                <!-- Column 2 -->
                <div class="h-full pb-12">
                    <div class="w-full h-full rounded-t-[2.5rem] rounded-b-2xl overflow-hidden relative group shadow-sm hover:shadow-md transition-shadow">
                        <div class="hero-slot absolute inset-0 transition-all duration-700 ease-in-out opacity-100 scale-100 blur-0" data-slot="2">
                            <img src="@heroImages[2]" alt="Gallery Item" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
                        </div>
                        <div class="absolute inset-0 bg-black/5 group-hover:bg-transparent transition-colors duration-500"></div>
                    </div>
                </div>

                <!-- Column 3 (Center) -->
                <div class="h-full pt-20 pb-20 relative flex justify-center">
                    <div class="w-full h-full rounded-t-[2.5rem] rounded-b-3xl overflow-hidden relative group shadow-md hover:shadow-lg transition-shadow">
                        <div class="hero-slot absolute inset-0 transition-all duration-700 ease-in-out opacity-100 scale-100 blur-0" data-slot="3">
                            <img src="@heroImages[3]" alt="Gallery Item" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
                        </div>
                        <div class="absolute inset-0 bg-black/5 group-hover:bg-transparent transition-colors duration-500"></div>
                    </div>
                    <!-- Floating CTA -->
                    <a asp-controller="Products" asp-action="Index" class="absolute bottom-12 z-30 inline-flex items-center gap-3 px-8 py-4 bg-neutral-900 hover:bg-neutral-800 text-white font-bold rounded-full shadow-2xl hover:-translate-y-1 transition-all">
                        Explore Collections
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 12h16m0 0l-6-6m6 6l-6 6"></path></svg>
                    </a>
                </div>

                <!-- Column 4 -->
                <div class="h-full pt-10 pb-6 hidden lg:block">
                    <div class="w-full h-full rounded-t-[2.5rem] rounded-b-2xl overflow-hidden relative group shadow-sm hover:shadow-md transition-shadow">
                        <div class="hero-slot absolute inset-0 transition-all duration-700 ease-in-out opacity-100 scale-100 blur-0" data-slot="4">
                            <img src="@heroImages[4]" alt="Gallery Item" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
                        </div>
                        <div class="absolute inset-0 bg-black/5 group-hover:bg-transparent transition-colors duration-500"></div>
                    </div>
                </div>

                <!-- Column 5 -->
                <div class="flex-col gap-4 lg:gap-5 h-full pt-16 hidden lg:flex">
                    <div class="h-28 rounded-t-[2rem] rounded-b-2xl overflow-hidden relative group shadow-sm hover:shadow-md transition-shadow">
                        <div class="hero-slot absolute inset-0 transition-all duration-700 ease-in-out opacity-100 scale-100 blur-0" data-slot="5">
                            <img src="@heroImages[5]" alt="Gallery Item" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
                        </div>
                        <div class="absolute inset-0 bg-black/5 group-hover:bg-transparent transition-colors duration-500"></div>
                    </div>
                    <div class="flex-1 rounded-t-[2.5rem] rounded-b-2xl overflow-hidden relative group shadow-sm hover:shadow-md transition-shadow">
                        <div class="hero-slot absolute inset-0 transition-all duration-700 ease-in-out opacity-100 scale-100 blur-0" data-slot="6">
                            <img src="@heroImages[6]" alt="Gallery Item" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
                        </div>
                        <div class="absolute inset-0 bg-black/5 group-hover:bg-transparent transition-colors duration-500"></div>
                    </div>
                </div>

            </div>

            <!-- Mobile Horizontal Scroll -->
            <div class="md:hidden flex overflow-x-auto snap-x snap-mandatory gap-4 pb-8 -mx-4 px-4 hide-scrollbar">
                @foreach (var i in new[] { 0, 3, 2, 4 })
                {
                    var withCta = i == 3;
                    <div class="w-[80vw] flex-shrink-0 h-[350px] rounded-t-[2.5rem] rounded-b-2xl snap-center relative shadow-sm overflow-hidden group@(withCta ? " flex items-end justify-center pb-8" : "")">
                        <div class="hero-slot absolute inset-0 transition-all duration-700 ease-in-out opacity-100 scale-100 blur-0" data-slot="@i">
                            <img src="@heroImages[i]" alt="Gallery Item" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
                        </div>
                        @if (withCta)
                        {
                            <a asp-controller="Products" asp-action="Index" class="relative z-10 inline-flex items-center gap-2 px-6 py-3 bg-neutral-900 text-white font-bold rounded-full shadow-xl">
                                Explore Collections <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 12h16m0 0l-6-6m6 6l-6 6"></path></svg>
                            </a>
                        }
                    </div>
                }
            </div>

            <!-- Mobile Badge/Avatars -->
            <div class="md:hidden flex items-center justify-between mt-4 border-t border-neutral-100 pt-8">
                <div class="flex items-center gap-3">
                    <button type="button" class="w-12 h-12 bg-neutral-900 rounded-full flex items-center justify-center text-white">
                        <svg class="w-4 h-4 ml-1" fill="currentColor" viewBox="0 0 20 20"><path d="M4 4l12 6-12 6z"></path></svg>
                    </button>
                    <span class="text-xs font-bold uppercase tracking-wider text-neutral-500">Watch Video</span>
                </div>
                <div class="flex -space-x-3">
                    <div class="w-10 h-10 rounded-full bg-blue-500 border-2 border-white flex items-center justify-center text-white text-lg">&#128104;&#8205;&#129490;</div>
                    <div class="w-10 h-10 rounded-full bg-purple-500 border-2 border-white flex items-center justify-center text-white text-lg">&#128105;&#127995;</div>
                    <div class="w-10 h-10 rounded-full bg-neutral-900 border-2 border-white flex items-center justify-center text-white text-sm font-bold z-10">+</div>
                </div>
            </div>

        </div>
    </section>

    <!-- ======================= TRUST TICKER ======================= -->
    <section class="bg-neutral-900 text-white overflow-hidden py-5 border-y border-neutral-800">
        <div class="flex whitespace-nowrap animate-ticker w-max hover:[animation-play-state:paused] cursor-default">
            @for (var set = 0; set < 2; set++)
            {
                <div class="flex px-4">
                    @foreach (var (text, sub) in trustItems)
                    {
                        <div class="flex items-center gap-8 mx-8">
                            <span class="text-sm font-bold tracking-[0.2em] uppercase">@text</span>
                            <span class="text-xs text-neutral-400 tracking-wider">(@sub)</span>
                            <span class="text-neutral-700 text-xl">&#10022;</span>
                        </div>
                    }
                </div>
            }
        </div>
    </section>

    <!-- ======================= CATEGORIES ======================= -->
    <section id="categories-section" class="relative w-full overflow-hidden cursor-none border-b border-neutral-100 py-10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 flex flex-col justify-center">
            @foreach (var cat in categories)
            {
                @if (string.IsNullOrEmpty(cat[1]))
                {
                    <a asp-controller="Products" asp-action="Index"
                       class="cat-link @(cat[2]) @(cat[3]) @(cat[4]) uppercase tracking-tighter leading-[0.85] text-neutral-900 hover:text-neutral-500 transition-colors duration-300 relative w-fit"
                       data-img="@cat[5]">@cat[0]</a>
                }
                else
                {
                    <a asp-controller="Products" asp-action="Index" asp-route-category="@cat[1]"
                       class="cat-link @(cat[2]) @(cat[3]) @(cat[4]) uppercase tracking-tighter leading-[0.85] text-neutral-900 hover:text-neutral-500 transition-colors duration-300 relative w-fit"
                       data-img="@cat[5]">@cat[0]</a>
                }
            }
        </div>

        <!-- THE ROUND INTERFACE (Dominant Popup Circle) -->
        <div id="cat-circle"
             class="absolute z-20 pointer-events-none rounded-full overflow-hidden w-[250px] h-[250px] sm:w-[400px] sm:h-[400px] lg:w-[450px] lg:h-[450px]
                    shadow-[0_0_80px_rgba(255,255,255,1),0_0_20px_rgba(255,255,255,0.8)]
                    transition-all duration-700 opacity-0 scale-80 left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
            <img id="cat-circle-img" src="" alt="" class="absolute inset-0 w-full h-full object-cover transition-opacity duration-500 ease-in-out opacity-0" />
        </div>

        <!-- CUSTOM CURSOR: Thick Ring -->
        <div id="cat-cursor"
             class="absolute z-30 pointer-events-none w-10 h-10 border-[3px] border-neutral-900 rounded-full transition-opacity duration-300 mix-blend-difference opacity-0">
        </div>
    </section>

    <!-- ======================= FLASH SALE ======================= -->
    <section class="bg-white py-10 overflow-hidden border-b border-neutral-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

            <!-- Header & Timer -->
            <div class="flex flex-col lg:flex-row justify-between items-start lg:items-end mb-8 border-b border-neutral-200 pb-6">
                <div>
                    <div class="flex items-center gap-4 mb-2">
                        <div class="w-2.5 h-2.5 bg-red-500 rounded-full animate-pulse"></div>
                        <span class="text-red-500 font-bold tracking-[0.3em] uppercase text-xs">Live Now</span>
                    </div>
                    <h2 class="text-5xl sm:text-6xl md:text-7xl font-black text-black uppercase tracking-tighter leading-[0.85]">
                        Flash<br /><span class="text-red-500">Sale</span>
                    </h2>
                </div>

                <div class="mt-6 lg:mt-0 flex flex-col items-start lg:items-end">
                    <p class="text-neutral-500 font-bold uppercase tracking-widest text-[0.65rem] mb-2">Offer Ends In</p>
                    <div id="flash-countdown" class="flex items-center gap-2 sm:gap-3 text-black font-mono text-3xl sm:text-4xl font-black">
                        <div id="cd-hours" class="bg-neutral-100 px-3 py-2 rounded-lg border border-neutral-200 shadow-inner w-16 sm:w-20 text-center">14</div>
                        <span class="text-red-500 -mt-1">:</span>
                        <div id="cd-minutes" class="bg-neutral-100 px-3 py-2 rounded-lg border border-neutral-200 shadow-inner w-16 sm:w-20 text-center">28</div>
                        <span class="text-red-500 -mt-1">:</span>
                        <div id="cd-seconds" class="bg-neutral-100 px-3 py-2 rounded-lg border border-neutral-200 shadow-inner w-16 sm:w-20 text-center">59</div>
                    </div>
                </div>
            </div>

            <!-- Product Grid -->
            @if (flashProducts.Any())
            {
                <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4 lg:gap-5">
                    @foreach (var (product, idx) in flashProducts.Select((p, i) => (p, i)))
                    {
                        var discount = idx % 2 == 0 ? 50 : idx % 3 == 0 ? 70 : 55;
                        var oldPrice = Math.Round(product.Price / (1 - discount / 100m));
                        <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="group cursor-pointer">
                            <div class="relative aspect-[3/4] w-full overflow-hidden bg-neutral-100 rounded-xl mb-3">
                                <div class="absolute top-2 left-2 z-20 bg-red-500 text-white font-black text-sm px-3 py-0.5 rounded-full uppercase tracking-wider transform -rotate-2 group-hover:rotate-0 transition-transform duration-300 shadow-md">
                                    -@discount%
                                </div>
                                <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "https://images.unsplash.com/photo-1521572267360-ee0c2909d518?auto=format&fit=crop&q=80&w=600" : product.ImageUrl)"
                                     alt="@product.Name"
                                     class="absolute inset-0 w-full h-full object-cover object-center grayscale group-hover:grayscale-0 transition-all duration-700 scale-100 group-hover:scale-105 mix-blend-multiply" />
                                <div class="absolute inset-0 bg-white/10 group-hover:bg-transparent transition-colors duration-500"></div>
                            </div>

                            <div class="flex flex-col">
                                <h3 class="text-black font-bold text-xs sm:text-sm uppercase tracking-wide mb-1 group-hover:text-red-500 transition-colors truncate">@product.Name</h3>
                                <div class="flex items-center gap-2">
                                    <span class="text-neutral-400 font-medium text-sm line-through decoration-red-500/50">&#2547;@oldPrice</span>
                                    <span class="text-red-500 font-black text-lg">&#2547;@(product.Price.ToString("0.##"))</span>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="py-10 text-center text-neutral-500">Flash sale products are unavailable right now.</div>
            }

        </div>
    </section>

    <!-- ======================= SUBSCRIPTION PROMO (SCAN REVEAL) ======================= -->
    <section id="scan-section" class="relative w-full bg-white overflow-hidden border-b border-neutral-100">

        <!-- BASE LAYER: Barcode + Brutalist Text -->
        <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">
            <div class="absolute inset-0 opacity-5 barcode-bg"></div>

            <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
                <p class="text-neutral-500 font-bold tracking-[0.4em] uppercase text-sm mb-4">Unlock Exclusive Perks</p>
                <h2 class="text-6xl sm:text-7xl lg:text-8xl font-black tracking-tighter text-neutral-900 uppercase leading-[0.85] mix-blend-multiply">
                    SCAN TO<br />SUBSCRIBE
                </h2>
            </div>
        </div>

        <!-- REVEAL LAYER -->
        <div id="scan-reveal" class="relative z-20 w-full bg-neutral-900 text-white flex items-center py-24 transition-all duration-500">
            <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-primary-900/40 via-neutral-900 to-neutral-900 opacity-50 pointer-events-none"></div>

            <div class="relative w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-center gap-8">

                <!-- Intro Text -->
                <div class="flex-1 text-left hidden lg:block">
                    <h3 class="text-6xl font-black mb-6 uppercase tracking-tighter bg-clip-text text-transparent bg-gradient-to-r from-white to-neutral-500">
                        Membership<br />Tiers
                    </h3>
                    <p class="text-neutral-400 max-w-sm text-lg leading-relaxed">
                        Join our exclusive club. Build your own custom package, set your delivery frequency, and enjoy dynamic pricing discounts!
                    </p>
                </div>

                <!-- Package 1 -->
                <div class="flex-1 bg-white/5 backdrop-blur-xl p-8 sm:p-10 rounded-[2rem] border border-white/10 hover:bg-white/10 transition-all duration-500 w-full max-w-sm relative overflow-hidden group">
                    <h3 class="text-sm font-bold mb-2 tracking-[0.2em] uppercase text-neutral-400">Monthly</h3>
                    <div class="text-6xl font-black mb-6 text-white tracking-tighter">$49<span class="text-2xl text-neutral-500 font-medium tracking-normal">/mo</span></div>
                    <p class="text-neutral-300 mb-8 text-sm leading-relaxed">
                        Curated fashion items delivered every 30 days. Perfect for staying trendy.
                    </p>
                    <ul class="space-y-4 mb-10 text-sm text-neutral-200">
                        <li class="flex items-center gap-4"><div class="w-1.5 h-1.5 bg-white rounded-full opacity-60"></div> Flexible package builder</li>
                        <li class="flex items-center gap-4"><div class="w-1.5 h-1.5 bg-white rounded-full opacity-60"></div> Pause or cancel anytime</li>
                    </ul>
                    <a asp-controller="Subscriptions" asp-action="Index" class="block text-center w-full py-5 bg-transparent border border-white/30 text-white font-bold uppercase tracking-widest text-sm rounded-full hover:bg-white hover:text-black transition-colors duration-300">
                        Select Plan
                    </a>
                </div>

                <!-- Package 2 (Most Popular) -->
                <div class="flex-1 bg-white p-8 sm:p-10 rounded-[2rem] shadow-[0_0_80px_rgba(255,255,255,0.15)] hover:-translate-y-2 hover:shadow-[0_20px_80px_rgba(255,255,255,0.25)] transition-all duration-500 w-full max-w-sm relative overflow-hidden group text-neutral-900">
                    <div class="absolute top-6 right-6 bg-black text-white text-[0.65rem] font-black uppercase tracking-[0.2em] px-4 py-2 rounded-full z-10">
                        Most Popular
                    </div>
                    <h3 class="text-sm font-bold mb-2 tracking-[0.2em] uppercase text-neutral-500">Yearly Pass</h3>
                    <div class="text-6xl font-black mb-6 text-black tracking-tighter">$399<span class="text-2xl text-neutral-400 font-medium tracking-normal">/yr</span></div>
