@model ContactInput
@{
    ViewData["Title"] = "Contact";
}
<main class="bg-white min-h-screen pt-12 pb-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-24">
            <h1 class="text-[12vw] sm:text-[10vw] leading-none font-black tracking-tighter uppercase text-black">Get In<br />Touch.</h1>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-16 lg:gap-24">
            <div class="md:col-span-5">
                <div class="mb-12">
                    <h3 class="text-sm font-black uppercase tracking-widest mb-4 border-b border-neutral-200 pb-2">Inquiries</h3>
                    <a href="mailto:hello@eshop.com" class="text-2xl sm:text-3xl font-bold hover:text-red-500 transition-colors">hello&#64;eshop.com</a>
                </div>
                <div class="mb-12">
                    <h3 class="text-sm font-black uppercase tracking-widest mb-4 border-b border-neutral-200 pb-2">Studio / Headquarters</h3>
                    <address class="not-italic text-neutral-500 text-lg leading-relaxed">
                        123 Fashion Avenue<br />
                        Industrial District<br />
                        Dhaka, Bangladesh 1212
                    </address>
                </div>
                <div>
                    <h3 class="text-sm font-black uppercase tracking-widest mb-4 border-b border-neutral-200 pb-2">Social</h3>
                    <div class="flex flex-col gap-3">
                        <a href="#" class="text-lg font-bold text-neutral-600 hover:text-red-500 transition-colors uppercase tracking-widest">Instagram</a>
                        <a href="#" class="text-lg font-bold text-neutral-600 hover:text-red-500 transition-colors uppercase tracking-widest">X / Twitter</a>
                        <a href="#" class="text-lg font-bold text-neutral-600 hover:text-red-500 transition-colors uppercase tracking-widest">LinkedIn</a>
                    </div>
                </div>
            </div>

            <div class="md:col-span-7">
                <form asp-action="Contact" method="post" class="space-y-12 bg-neutral-50 p-10 sm:p-16 rounded-[2rem]">
                    <div class="relative">
                        <input type="text" asp-for="Name" placeholder=" " class="block w-full px-0 py-4 text-xl bg-transparent border-0 border-b-2 border-neutral-300 appearance-none focus:outline-none focus:ring-0 focus:border-black peer" />
                        <label asp-for="Name" class="absolute text-lg text-neutral-400 duration-300 transform -translate-y-8 scale-75 top-4 z-10 origin-[0] peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-8 uppercase font-bold tracking-widest pointer-events-none">Your Name</label>
                        <span asp-validation-for="Name" class="text-red-500 text-sm"></span>
                    </div>

                    <div class="relative">
                        <input type="email" asp-for="Email" placeholder=" " class="block w-full px-0 py-4 text-xl bg-transparent border-0 border-b-2 border-neutral-300 appearance-none focus:outline-none focus:ring-0 focus:border-black peer" />
                        <label asp-for="Email" class="absolute text-lg text-neutral-400 duration-300 transform -translate-y-8 scale-75 top-4 z-10 origin-[0] peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-8 uppercase font-bold tracking-widest pointer-events-none">Email Address</label>
                        <span asp-validation-for="Email" class="text-red-500 text-sm"></span>
                    </div>

                    <div class="relative">
                        <textarea asp-for="Message" rows="4" placeholder=" " class="block w-full px-0 py-4 text-xl bg-transparent border-0 border-b-2 border-neutral-300 appearance-none focus:outline-none focus:ring-0 focus:border-black peer resize-none"></textarea>
                        <label asp-for="Message" class="absolute text-lg text-neutral-400 duration-300 transform -translate-y-8 scale-75 top-4 z-10 origin-[0] peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-8 uppercase font-bold tracking-widest pointer-events-none">Message</label>
                        <span asp-validation-for="Message" class="text-red-500 text-sm"></span>
                    </div>

                    <button type="submit" class="w-full bg-black text-white font-black uppercase tracking-widest py-6 text-sm rounded-full hover:bg-red-500 hover:shadow-[0_0_30px_rgba(239,68,68,0.4)] transition-all duration-300 transform hover:-translate-y-1 mt-8">
                        Send Message
                    </button>
                </form>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
