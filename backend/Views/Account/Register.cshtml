@model RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
}
<main class="min-h-[70vh] flex items-center justify-center px-4 py-16 bg-background">
    <div class="w-full max-w-md">
        <div class="bg-card p-8 sm:p-10 rounded-2xl shadow-sm border border-border">
            <h1 class="text-2xl font-bold text-foreground mb-2">Create your account</h1>
            <p class="text-neutral-500 text-sm mb-8">Join E-Shop to track orders, earn rewards, and save your wishlist.</p>

            <div asp-validation-summary="ModelOnly" class="mb-4 rounded-lg px-4 py-3 text-sm font-medium bg-danger-500/15 text-danger-600"></div>

            <form asp-action="Register" method="post" class="space-y-5">
                <div>
                    <label asp-for="Name" class="block text-sm font-semibold text-foreground mb-2"></label>
                    <input asp-for="Name" class="w-full rounded-xl border border-border px-4 py-3 focus:ring-2 focus:ring-primary-500 outline-none bg-white" placeholder="Jane Doe" />
                    <span asp-validation-for="Name" class="mt-1 block text-sm text-danger-600"></span>
                </div>
                <div>
                    <label asp-for="Email" class="block text-sm font-semibold text-foreground mb-2"></label>
                    <input asp-for="Email" class="w-full rounded-xl border border-border px-4 py-3 focus:ring-2 focus:ring-primary-500 outline-none bg-white" placeholder="you@example.com" />
                    <span asp-validation-for="Email" class="mt-1 block text-sm text-danger-600"></span>
                </div>
                <div>
                    <label asp-for="Password" class="block text-sm font-semibold text-foreground mb-2"></label>
                    <input asp-for="Password" class="w-full rounded-xl border border-border px-4 py-3 focus:ring-2 focus:ring-primary-500 outline-none bg-white" placeholder="At least 6 characters" />
                    <span asp-validation-for="Password" class="mt-1 block text-sm text-danger-600"></span>
                </div>
                <div>
                    <label asp-for="ConfirmPassword" class="block text-sm font-semibold text-foreground mb-2"></label>
                    <input asp-for="ConfirmPassword" class="w-full rounded-xl border border-border px-4 py-3 focus:ring-2 focus:ring-primary-500 outline-none bg-white" placeholder="Repeat password" />
                    <span asp-validation-for="ConfirmPassword" class="mt-1 block text-sm text-danger-600"></span>
                </div>
                <button type="submit" class="w-full rounded-full bg-primary-600 py-3 font-semibold text-white hover:bg-primary-700 transition">Create Account</button>
            </form>

            <p class="mt-8 text-center text-sm text-neutral-500">
                Already have an account?
                <a asp-action="Login" class="font-semibold text-primary-600 hover:underline">Sign in</a>
            </p>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
