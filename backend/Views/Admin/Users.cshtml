@model AdminUsersViewModel
@{
    ViewData["Title"] = "Manage Users";
}
<main class="min-h-screen p-8 bg-background">
    <div class="max-w-6xl mx-auto">
        <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
            <h1 class="text-3xl font-bold text-foreground">Manage Users</h1>
            <a asp-action="Index" class="rounded-full border border-border px-5 py-2.5 text-sm font-semibold hover:border-neutral-400 transition">Back to Dashboard</a>
        </div>

        <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
            @if (!Model.Users.Any())
            {
                <p class="text-sm text-neutral-500">No users found.</p>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead>
                            <tr class="border-b border-border text-xs uppercase tracking-widest text-neutral-500">
                                <th class="py-3 pr-4">Name</th>
                                <th class="py-3 pr-4">Email</th>
                                <th class="py-3 pr-4">Role</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-border text-sm">
                            @foreach (var user in Model.Users)
                            {
                                <tr>
                                    <td class="py-3 pr-4 font-semibold text-foreground">@user.Name</td>
                                    <td class="py-3 pr-4 text-neutral-500">@user.Email</td>
                                    <td class="py-3 pr-4">
                                        <span class="rounded-full px-2.5 py-0.5 text-xs font-bold @(user.Role == "Admin" ? "bg-primary-600/10 text-primary-700" : "bg-neutral-100 text-neutral-500")">@user.Role</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</main>
