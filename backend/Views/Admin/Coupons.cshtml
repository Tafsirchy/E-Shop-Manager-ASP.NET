@model AdminCouponsViewModel
@{
    ViewData["Title"] = "Manage Offers";
}
<main class="min-h-screen">
    <div class="max-w-5xl mx-auto">
        <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
            <h1 class="text-2xl font-bold text-foreground">Manage Offers</h1>
            <p class="text-sm text-neutral-500">@Model.Coupons.Count offer(s)</p>
        </div>

        <div class="grid gap-6 lg:grid-cols-[360px_1fr]">
            <div class="rounded-2xl border border-border bg-card p-6 shadow-sm h-fit">
                <h2 class="text-lg font-bold text-foreground mb-4">Create Offer</h2>
                <form asp-action="CreateCoupon" method="post" class="space-y-4">
                    <div>
                        <label for="Code" class="block text-sm font-semibold mb-1.5">Code</label>
                        <input type="text" id="Code" name="Code" required placeholder="SUMMER20"
                               class="w-full rounded-xl border border-border px-4 py-2.5 uppercase focus:ring-2 focus:ring-primary-500 outline-none" />
                    </div>
                    <div>
                        <label for="DiscountValue" class="block text-sm font-semibold mb-1.5">Discount Value</label>
                        <input type="number" id="DiscountValue" name="DiscountValue" min="0.01" step="0.01" required
                               class="w-full rounded-xl border border-border px-4 py-2.5 focus:ring-2 focus:ring-primary-500 outline-none" />
                        <p class="mt-1 text-xs text-neutral-400">Amount or percentage depending on how coupons are applied at checkout.</p>
                    </div>
                    <div>
                        <label for="RequiredPoints" class="block text-sm font-semibold mb-1.5">Required Points</label>
                        <input type="number" id="RequiredPoints" name="RequiredPoints" min="0" value="0"
                               class="w-full rounded-xl border border-border px-4 py-2.5 focus:ring-2 focus:ring-primary-500 outline-none" />
                        <p class="mt-1 text-xs text-neutral-400">Reward points a member needs to claim this coupon.</p>
                    </div>
                    <button type="submit" class="w-full rounded-full bg-primary-600 py-2.5 font-semibold text-white hover:bg-primary-700 transition">Create Offer</button>
                </form>
            </div>

            <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
                <h2 class="text-lg font-bold text-foreground mb-4">All Offers</h2>
                @if (!Model.Coupons.Any())
                {
                    <p class="text-sm text-neutral-500">No offers yet. Create your first offer on the left.</p>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="w-full text-left">
                            <thead>
                                <tr class="border-b border-border text-xs uppercase tracking-widest text-neutral-500">
                                    <th class="py-3 pr-4">Code</th>
                                    <th class="py-3 pr-4">Discount</th>
                                    <th class="py-3 pr-4">Points</th>
                                    <th class="py-3 text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-border text-sm">
                                @foreach (var coupon in Model.Coupons)
                                {
                                    <tr>
                                        <td class="py-3 pr-4 font-mono font-bold text-foreground uppercase">@coupon.Code</td>
                                        <td class="py-3 pr-4 text-success-600">&#2547;@coupon.DiscountValue.ToString("0.##")</td>
                                        <td class="py-3 pr-4">@coupon.RequiredPoints</td>
                                        <td class="py-3 text-right whitespace-nowrap">
                                            <button type="button" data-coupon-edit="@coupon.Id" class="font-semibold text-primary-600 hover:underline">Edit</button>
                                            <form asp-action="DeleteCoupon" method="post" class="inline ml-4"
                                                  onsubmit="return confirm('Delete offer &quot;@Html.Encode(coupon.Code)&quot;?');">
                                                <input type="hidden" name="id" value="@coupon.Id" />
                                                <button type="submit" class="font-semibold text-danger-500 hover:underline">Delete</button>
                                            </form>
                                        </td>
                                    </tr>
                                    <tr data-coupon-edit-row="@coupon.Id" class="hidden">
                                        <td colspan="4" class="py-3">
                                            <form asp-action="UpdateCoupon" method="post" class="flex flex-wrap items-end gap-3">
                                                <input type="hidden" name="id" value="@coupon.Id" />
                                                <div class="flex-1 min-w-[150px]">
                                                    <label class="block text-xs font-semibold text-neutral-500 mb-1">Code</label>
                                                    <input type="text" name="code" value="@coupon.Code" class="w-full rounded-xl border border-border px-3 py-2 text-sm uppercase outline-none focus:ring-2 focus:ring-primary-500" />
                                                </div>
                                                <div class="w-40">
                                                    <label class="block text-xs font-semibold text-neutral-500 mb-1">Discount</label>
                                                    <input type="number" name="discountValue" min="0.01" step="0.01" value="@coupon.DiscountValue" class="w-full rounded-xl border border-border px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-primary-500" />
                                                </div>
                                                <div class="w-32">
                                                    <label class="block text-xs font-semibold text-neutral-500 mb-1">Points</label>
                                                    <input type="number" name="requiredPoints" min="0" value="@coupon.RequiredPoints" class="w-full rounded-xl border border-border px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-primary-500" />
                                                </div>
                                                <button type="submit" class="rounded-full bg-primary-600 px-5 py-2 text-sm font-semibold text-white hover:bg-primary-700 transition">Save</button>
                                                <button type="button" data-coupon-cancel="@coupon.Id" class="rounded-full border border-border px-5 py-2 text-sm font-semibold text-neutral-600 hover:border-neutral-400 transition">Cancel</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        document.querySelectorAll('[data-coupon-edit]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var id = btn.getAttribute('data-coupon-edit');
                var row = document.querySelector('[data-coupon-edit-row="' + id + '"]');
                if (row) row.classList.toggle('hidden');
            });
        });
        document.querySelectorAll('[data-coupon-cancel]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var id = btn.getAttribute('data-coupon-cancel');
                var row = document.querySelector('[data-coupon-edit-row="' + id + '"]');
                if (row) row.classList.add('hidden');
            });
        });
    </script>
}
