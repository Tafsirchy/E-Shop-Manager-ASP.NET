@model AdminProductsViewModel
@{
    ViewData["Title"] = "Manage Products";
}
<main class="min-h-screen p-8 bg-background">
    <div class="max-w-6xl mx-auto">
        <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
            <h1 class="text-3xl font-bold text-foreground">Manage Products</h1>
            <div class="flex gap-2">
                <a asp-controller="Products" asp-action="Create" class="rounded-full bg-primary-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-primary-700 transition">+ New Product</a>
                <a asp-action="Index" class="rounded-full border border-border px-5 py-2.5 text-sm font-semibold hover:border-neutral-400 transition">Back to Dashboard</a>
            </div>
        </div>

        <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
            @if (!Model.Products.Any())
            {
                <p class="text-sm text-neutral-500">No products found.</p>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead>
                            <tr class="border-b border-border text-xs uppercase tracking-widest text-neutral-500">
                                <th class="py-3 pr-4">Product</th>
                                <th class="py-3 pr-4">Category</th>
                                <th class="py-3 pr-4">Price</th>
                                <th class="py-3 pr-4">Stock</th>
                                <th class="py-3 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-border text-sm">
                            @foreach (var product in Model.Products)
                            {
                                <tr>
                                    <td class="py-3 pr-4">
                                        <div class="flex items-center gap-3">
                                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                                            {
                                                <img src="@product.ImageUrl" alt="@product.Name" class="h-10 w-10 rounded-lg object-cover" />
                                            }
                                            else
                                            {
                                                <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-neutral-100 text-xs text-neutral-400">N/A</span>
                                            }
                                            <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="font-semibold text-foreground hover:text-primary-600">@product.Name</a>
                                        </div>
                                    </td>
                                    <td class="py-3 pr-4 text-neutral-500">@product.Category</td>
                                    <td class="py-3 pr-4">&#2547;@product.Price.ToString("0.##")</td>
                                    <td class="py-3 pr-4">
                                        <span class="font-medium @(product.Stock > 10 ? "text-success-600" : product.Stock > 0 ? "text-warning-500" : "text-danger-500")">@product.Stock</span>
                                    </td>
                                    <td class="py-3 text-right whitespace-nowrap">
                                        <a asp-controller="Products" asp-action="Edit" asp-route-id="@product.Id" class="font-semibold text-primary-600 hover:underline">Edit</a>
                                        @{
                                            var confirmDelete = $"return confirm('Delete \"{Html.Encode(product.Name)}\"? This cannot be undone.');";
                                        }
                                        <form asp-controller="Products" asp-action="Delete" asp-route-id="@product.Id" method="post" class="inline ml-4" onsubmit="@confirmDelete">
                                            <button type="submit" class="font-semibold text-danger-500 hover:underline">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</main>
