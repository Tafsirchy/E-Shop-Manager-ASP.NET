@model AdminPackagesViewModel
@{
    ViewData["Title"] = "Manage Packages";
}
<main class="min-h-screen">
    <div class="max-w-6xl mx-auto">
        <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
            <h1 class="text-2xl font-bold text-foreground">Manage Packages</h1>
            <p class="text-sm text-neutral-500">@Model.Packages.Count package(s)</p>
        </div>

        <div class="grid gap-6 lg:grid-cols-[360px_1fr]">
            <div class="rounded-2xl border border-border bg-card p-6 shadow-sm h-fit">
                <h2 class="text-lg font-bold text-foreground mb-4">Create Package</h2>
                <form asp-action="CreatePackage" method="post" class="space-y-4">
                    <div>
                        <label for="name" class="block text-sm font-semibold mb-1.5">Name</label>
                        <input type="text" id="name" name="name" required class="w-full rounded-xl border border-border px-4 py-2.5 focus:ring-2 focus:ring-primary-500 outline-none" />
                    </div>
                    <div>
                        <label for="price" class="block text-sm font-semibold mb-1.5">Price</label>
                        <input type="number" id="price" name="price" min="0" step="0.01" required class="w-full rounded-xl border border-border px-4 py-2.5 focus:ring-2 focus:ring-primary-500 outline-none" />
                    </div>
                    <div>
                        <label for="billingType" class="block text-sm font-semibold mb-1.5">Billing Type</label>
                        <select id="billingType" name="billingType" class="w-full rounded-xl border border-border px-4 py-2.5 outline-none">
                            <option value="Monthly">Monthly</option>
                            <option value="One-time">One-time</option>
                        </select>
                    </div>
                    <div>
                        <label for="features" class="block text-sm font-semibold mb-1.5">Features <span class="font-normal text-neutral-400">(comma-separated)</span></label>
                        <textarea id="features" name="features" rows="3" placeholder="Premium Support, API Access"
                                  class="w-full rounded-xl border border-border px-4 py-2.5 focus:ring-2 focus:ring-primary-500 outline-none"></textarea>
                    </div>
                    <button type="submit" class="w-full rounded-full bg-primary-600 py-2.5 font-semibold text-white hover:bg-primary-700 transition">Create Package</button>
                </form>
            </div>

            <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
                @if (!Model.Packages.Any())
                {
                    <p class="text-sm text-neutral-500">No packages yet.</p>
                }
                else
                {
                    <div class="space-y-4">
                        @foreach (var package in Model.Packages)
                        {
                            <div class="rounded-xl border border-border p-4 @(package.IsActive ? "" : "opacity-70")">
                                <div class="flex flex-wrap items-start justify-between gap-3">
                                    <div>
                                        <div class="flex items-center gap-2 mb-1">
                                            <h3 class="font-bold text-foreground">@package.Name</h3>
                                            <span class="rounded-full bg-neutral-100 px-2 py-0.5 text-xs font-semibold text-neutral-500">@package.Type</span>
                                            @if (!package.IsActive)
                                            {
                                                <span class="rounded-full bg-danger-500/10 px-2 py-0.5 text-xs font-semibold text-danger-500">Inactive</span>
                                            }
                                        </div>
                                        <p class="text-sm font-semibold text-primary-700">&#2547;@package.Price.ToString("0.##") / @package.BillingType.ToLower()</p>
                                        @if (package.Features.Any())
                                        {
                                            <p class="mt-1 text-xs text-neutral-400">@string.Join(" \u00b7 ", package.Features)</p>
                                        }
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <button type="button" data-pkg-toggle="@package.Id" class="rounded-full border border-border px-3 py-1 text-xs font-semibold text-neutral-600 hover:border-neutral-400 transition">Edit</button>
                                        <form asp-action="TogglePackage" method="post" class="inline">
                                            <input type="hidden" name="id" value="@package.Id" />
                                            <button type="submit" class="rounded-full border border-border px-3 py-1 text-xs font-semibold @(package.IsActive ? "text-warning-600 hover:border-warning-400" : "text-success-600 hover:border-success-400") transition">@(package.IsActive ? "Deactivate" : "Activate")</button>
                                        </form>
                                        <form asp-action="DeletePackage" method="post" class="inline"
                                              onsubmit="return confirm('Delete package &quot;@Html.Encode(package.Name)&quot;?');">
                                            <input type="hidden" name="id" value="@package.Id" />
                                            <button type="submit" class="rounded-full border border-danger-300 px-3 py-1 text-xs font-semibold text-danger-500 hover:bg-danger-500/10 transition">Delete</button>
                                        </form>
                                    </div>
                                </div>

                                <form asp-action="UpdatePackage" method="post" class="mt-4 hidden grid gap-4 sm:grid-cols-2" data-pkg-edit="@package.Id">
                                    <input type="hidden" name="id" value="@package.Id" />
                                    <div>
                                        <label class="block text-xs font-semibold text-neutral-500 mb-1">Name</label>
                                        <input type="text" name="name" value="@package.Name" class="w-full rounded-xl border border-border px-4 py-2 text-sm outline-none focus:ring-2 focus:ring-primary-500" />
                                    </div>
                                    <div>
                                        <label class="block text-xs font-semibold text-neutral-500 mb-1">Price</label>
                                        <input type="number" name="price" min="0" step="0.01" value="@package.Price" class="w-full rounded-xl border border-border px-4 py-2 text-sm outline-none focus:ring-2 focus:ring-primary-500" />
                                    </div>
                                    <div>
                                        <label class="block text-xs font-semibold text-neutral-500 mb-1">Billing Type</label>
                                        <select name="billingType" class="w-full rounded-xl border border-border px-4 py-2 text-sm outline-none">
                                            <option value="Monthly" selected="@(package.BillingType == "Monthly")">Monthly</option>
                                            <option value="One-time" selected="@(package.BillingType == "One-time")">One-time</option>
                                        </select>
                                    </div>
                                    <div class="sm:col-span-2">
                                        <label class="block text-xs font-semibold text-neutral-500 mb-1">Features <span class="font-normal">(comma-separated)</span></label>
                                        <textarea name="features" rows="2" class="w-full rounded-xl border border-border px-4 py-2 text-sm outline-none focus:ring-2 focus:ring-primary-500">@string.Join(", ", package.Features)</textarea>
                                    </div>
                                    <div class="sm:col-span-2">
                                        <button type="submit" class="rounded-full bg-primary-600 px-5 py-2 text-sm font-semibold text-white hover:bg-primary-700 transition">Save Changes</button>
                                        <button type="button" data-pkg-cancel="@package.Id" class="rounded-full border border-border px-5 py-2 text-sm font-semibold text-neutral-600 hover:border-neutral-400 transition">Cancel</button>
                                    </div>
                                </form>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        document.querySelectorAll('[data-pkg-toggle]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var id = btn.getAttribute('data-pkg-toggle');
                var form = document.querySelector('[data-pkg-edit="' + id + '"]');
                if (form) form.classList.toggle('hidden');
            });
        });
        document.querySelectorAll('[data-pkg-cancel]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var id = btn.getAttribute('data-pkg-cancel');
                var form = document.querySelector('[data-pkg-edit="' + id + '"]');
                if (form) form.classList.add('hidden');
            });
        });
    </script>
}
