@model AdminLowStockViewModel
@{
    ViewData["Title"] = "Low Stock";
}
<main class="min-h-screen">
    <div class="max-w-4xl mx-auto">
        <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
            <h1 class="text-2xl font-bold text-foreground">Low Stock</h1>
        </div>

        <div class="rounded-2xl border border-border bg-card p-6 shadow-sm mb-6">
            <form method="get" class="flex items-end gap-3">
                <div>
                    <label for="threshold" class="block text-sm font-semibold mb-1.5">Threshold</label>
                    <input type="number" id="threshold" name="threshold" min="0" value="@Context.Request.Query["threshold"]"
                           class="w-32 rounded-xl border border-border px-4 py-2.5 focus:ring-2 focus:ring-primary-500 outline-none" />
                </div>
                <button type="submit" class="rounded-full bg-primary-600 px-6 py-2.5 text-sm font-semibold text-white hover:bg-primary-700 transition">Filter</button>
            </form>
        </div>

        <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
            @if (!Model.Products.Any())
            {
                <p class="text-sm text-neutral-500">No products below the threshold.</p>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead>
                            <tr class="border-b border-border text-xs uppercase tracking-widest text-neutral-500">
                                <th class="py-3 pr-4">Product</th>
                                <th class="py-3 pr-4">Category</th>
                                <th class="py-3 pr-4 text-right">Price</th>
                                <th class="py-3 text-right">Stock</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-border text-sm">
                            @foreach (var product in Model.Products)
                            {
                                <tr>
                                    <td class="py-3 pr-4">
                                        <a asp-controller="Products" asp-action="Edit" asp-route-id="@product.Id" class="font-semibold text-foreground hover:text-primary-600">@product.Name</a>
                                    </td>
                                    <td class="py-3 pr-4 text-neutral-500">@product.Category</td>
                                    <td class="py-3 pr-4 text-right">&#2547;@product.Price.ToString("0.##")</td>
                                    <td class="py-3 text-right font-bold @(product.Stock == 0 ? "text-danger-500" : "text-warning-500")">@product.Stock</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</main>
