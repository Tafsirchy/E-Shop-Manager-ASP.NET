@model MembershipIndexViewModel
@{
    ViewData["Title"] = "Your Membership";
    var membership = Model.Membership;
}
<main class="min-h-screen py-8 bg-background">
    <div class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8">
        <h1 class="text-3xl font-bold text-foreground mb-8">Your Membership</h1>

        <div class="grid gap-6 sm:grid-cols-3 mb-8">
            <div class="rounded-2xl border border-border bg-card p-6 shadow-sm text-center">
                <p class="text-sm font-semibold text-neutral-500 uppercase tracking-wide mb-2">Tier</p>
                <p class="text-2xl font-black @(membership.CurrentRole == "Premium" ? "text-primary-600" : "text-foreground")">@membership.CurrentRole</p>
            </div>
            <div class="rounded-2xl border border-border bg-card p-6 shadow-sm text-center">
                <p class="text-sm font-semibold text-neutral-500 uppercase tracking-wide mb-2">Lifetime Spend</p>
                <p class="text-2xl font-black text-foreground">&#2547;@membership.TotalSpent.ToString("0.##")</p>
            </div>
            <div class="rounded-2xl border border-border bg-card p-6 shadow-sm text-center">
                <p class="text-sm font-semibold text-neutral-500 uppercase tracking-wide mb-2">Reward Points</p>
                <p class="text-2xl font-black text-accent-600">@membership.RewardPoints</p>
            </div>
        </div>

        @if (membership.CurrentRole == "Premium")
        {
            <div class="rounded-2xl border border-primary-300 bg-primary-600/5 p-6 mb-8">
                <h2 class="font-bold text-primary-700 mb-1">&#9733; Premium perks active</h2>
                <p class="text-sm text-neutral-600">You receive 10% off every order automatically at checkout.</p>
            </div>
        }
        else
        {
            <div class="rounded-2xl border border-border bg-card p-6 mb-8">
                <h2 class="font-bold text-foreground mb-1">Reach Premium</h2>
                <p class="text-sm text-neutral-600 mb-4">Spend &#2547;500 lifetime to unlock 10% off all orders.</p>
                <div class="h-3 rounded-full bg-neutral-100 overflow-hidden">
                    <div class="h-full rounded-full bg-primary-600" style="width:@(Math.Clamp((double)(membership.TotalSpent / 500m) * 100, 0, 100))%"></div>
                </div>
            </div>
        }

        <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
            <h2 class="text-lg font-bold text-foreground mb-4">Claim a Coupon</h2>
            <form asp-controller="Membership" asp-action="ClaimCoupon" method="post" class="flex flex-col sm:flex-row gap-3">
                <input type="text" name="Code" placeholder="Enter coupon code" required
                       class="flex-1 rounded-xl border border-border px-4 py-3 focus:ring-2 focus:ring-primary-500 outline-none uppercase" />
                <button type="submit" class="rounded-full bg-primary-600 px-8 py-3 font-semibold text-white hover:bg-primary-700 transition">Claim</button>
            </form>
            <p class="mt-3 text-xs text-neutral-400">Coupons are redeemed against your reward points balance.</p>
        </div>

        <div class="rounded-2xl border border-border bg-card p-6 shadow-sm mt-6">
            <h2 class="text-lg font-bold text-foreground mb-4">My Coupons</h2>

            @{
                var activeCoupons = membership.ClaimedCoupons.Where(c => c.Status == "Active").ToList();
                var usedCoupons = membership.ClaimedCoupons.Where(c => c.Status == "Used").ToList();
            }

            @if (!activeCoupons.Any() && !usedCoupons.Any())
            {
                <p class="text-sm text-neutral-500">You haven't claimed any coupons yet. Claim one above with your reward points.</p>
            }
            else
            {
                @if (activeCoupons.Any())
                {
                    <p class="text-xs font-semibold text-neutral-400 uppercase tracking-wide mb-2">Active</p>
                    <div class="space-y-2 mb-4">
                        @foreach (var c in activeCoupons)
                        {
                            <div class="flex items-center justify-between gap-3 rounded-xl border border-success-200 bg-success-50 p-3">
                                <div>
                                    <p class="font-semibold text-success-700 uppercase">@c.Code</p>
                                    <p class="text-sm text-success-700">&#2547;@c.DiscountValue.ToString("0.##") off</p>
                                    <p class="mt-0.5 text-xs text-neutral-400">Claimed @c.ClaimedAt.ToLocalTime().ToString("d MMM yyyy")</p>
                                </div>
                                <form asp-controller="Cart" asp-action="ApplyCoupon" method="post">
                                    <input type="hidden" name="CouponCode" value="@c.Code" />
                                    <input type="hidden" name="ReturnUrl" value="@Url.Action("Index", "Cart")" />
                                    <button type="submit" class="rounded-full bg-primary-600 px-5 py-2 text-sm font-semibold text-white hover:bg-primary-700 transition">Apply in cart</button>
                                </form>
                            </div>
                        }
                    </div>
                }

                @if (usedCoupons.Any())
                {
                    <p class="text-xs font-semibold text-neutral-400 uppercase tracking-wide mb-2">Used</p>
                    <div class="space-y-2">
                        @foreach (var c in usedCoupons)
                        {
                            <div class="flex items-center justify-between gap-3 rounded-xl border border-border bg-neutral-50 p-3 opacity-70">
                                <div>
                                    <p class="font-semibold text-neutral-500 uppercase line-through">@c.Code</p>
                                    <p class="text-sm text-neutral-400">&#2547;@c.DiscountValue.ToString("0.##") off &middot; used</p>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
</main>
