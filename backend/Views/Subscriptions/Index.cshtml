@model SubscriptionsIndexViewModel
@inject CurrentUser Me
@{
    ViewData["Title"] = "Subscription Plans";
}
<main class="min-h-screen p-8 bg-background">
    <div class="max-w-6xl mx-auto">
        <h1 class="text-3xl font-bold text-foreground mb-2">Subscription Plans</h1>
        <p class="text-neutral-500 mb-10">Pick a prebuilt plan or compose your own from the features below.</p>

        @if (Model.Quote != null)
        {
            <div class="rounded-2xl border border-primary-300 bg-primary-600/5 p-6 mb-10">
                <h2 class="font-bold text-primary-700 mb-3">Your custom quote &mdash; @Model.Quote.Name</h2>
                <ul class="list-disc pl-6 text-sm text-neutral-600 mb-4">
                    @foreach (var feature in Model.QuotedFeatures)
                    {
                        <li>@feature</li>
                    }
                </ul>
                <div class="flex flex-wrap items-center gap-4 mb-4">
                    <span class="text-2xl font-black text-primary-700">&#2547;@Model.Quote.Price.ToString("0.##")</span>
                    <span class="text-sm font-semibold text-neutral-500">@Model.Quote.BillingType</span>
                    @if (Model.Quote.Offer != null)
                    {
                        <span class="rounded-full bg-success-500/15 px-3 py-1 text-sm font-semibold text-success-600">
                            Loyalty discount: @Model.Quote.Offer.Discount% off (spend over &#2547;@Model.Quote.Offer.Threshold)
                        </span>
                    }
                </div>
                <form asp-controller="Subscriptions" asp-action="PurchaseCustom" method="post" class="inline-block">
                    @foreach (var feature in Model.QuotedFeatures)
                    {
                        <input type="hidden" name="features" value="@feature" />
                    }
                    <button type="submit" class="rounded-full bg-primary-600 px-8 py-3 font-semibold text-white hover:bg-primary-700 transition">Purchase This Plan</button>
                </form>
            </div>
        }

        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 mb-14">
            @foreach (var row in Model.Packages.Where(p => p.Package.IsActive))
            {
                var package = row.Package;
                <div class="flex flex-col rounded-2xl border border-border bg-card p-6 shadow-sm @(row.IsSubscribed ? "border-primary-400 ring-2 ring-primary-400/30" : "")">
                    <div class="mb-4">
                        <div class="flex items-center justify-between mb-1">
                            <h3 class="text-lg font-bold text-foreground">@package.Name</h3>
                            <span class="rounded-full bg-neutral-100 px-2.5 py-0.5 text-xs font-semibold text-neutral-500">@package.Type</span>
                        </div>
                        <p class="text-3xl font-black text-foreground">&#2547;@package.Price.ToString("0.##")<span class="text-sm font-medium text-neutral-500"> / @package.BillingType.ToLower()</span></p>
                    </div>
                    <ul class="space-y-2 text-sm text-neutral-600 mb-6 flex-1">
                        @foreach (var feature in package.Features)
                        {
                            <li class="flex items-start gap-2"><span class="text-success-600 mt-0.5">&#10003;</span> @feature</li>
                        }
                    </ul>
                    @if (!Me.IsAuthenticated)
                    {
                        <button type="button" data-auth-toggle="signin" data-return-url="/Subscriptions" class="block w-full rounded-full border border-border px-5 py-2.5 text-center font-semibold hover:border-neutral-400 transition cursor-pointer">Sign in to subscribe</button>
                    }
                    else if (row.IsSubscribed)
                    {
                        <span class="block rounded-full bg-success-500/15 px-5 py-2.5 text-center font-semibold text-success-600">Active</span>
                    }
                    else
                    {
                        <form asp-controller="Subscriptions" asp-action="Subscribe" method="post">
                            <input type="hidden" name="packageId" value="@package.Id" />
                            <button type="submit" class="w-full rounded-full bg-primary-600 px-5 py-2.5 font-semibold text-white hover:bg-primary-700 transition">Subscribe</button>
                        </form>
                    }
                </div>
            }
        </div>

        @if (Me.IsAuthenticated)
        {
            <section class="grid gap-6 lg:grid-cols-[1fr_360px] mb-14">
                <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
                    <h2 class="text-xl font-bold text-foreground mb-2">Build Your Own Plan</h2>
                    <p class="text-sm text-neutral-500 mb-6">Base price &#2547;500 plus per-feature pricing, adjusted for your loyalty tier.</p>
                    <form asp-controller="Subscriptions" asp-action="BuildCustom" method="post" class="grid sm:grid-cols-2 gap-3 mb-6">
                        @foreach (var feature in Model.AvailableFeatures)
                        {
                            <label class="flex items-center gap-3 rounded-xl border border-border px-4 py-3 cursor-pointer has-checked:border-primary-400 has-checked:bg-primary-600/5">
                                <input type="checkbox" name="features" value="@feature" checked="@(Model.QuotedFeatures.Contains(feature))" class="accent-primary-600" />
                                <span class="font-medium text-sm text-foreground">@feature</span>
                            </label>
                        }
                        <div class="sm:col-span-2 flex flex-wrap gap-3 pt-2">
                            <button type="submit" class="rounded-full border-2 border-primary-600 px-8 py-2.5 font-semibold text-primary-600 hover:bg-primary-600 hover:text-white transition">Get Quote</button>
                        </div>
                    </form>
                </div>

                <div class="rounded-2xl border border-border bg-card p-6 shadow-sm h-fit">
                    <h2 class="text-lg font-bold text-foreground mb-4">My Subscriptions</h2>
                    @if (!Model.MySubscriptions.Any())
                    {
                        <p class="text-sm text-neutral-500">No active subscriptions.</p>
                    }
                    else
                    {
                        <ul class="space-y-4">
                            @foreach (var sub in Model.MySubscriptions)
                            {
                                var package = Model.PackageLookup.GetValueOrDefault(sub.PackageId);
                                <li class="rounded-xl border border-border p-4">
                                    <div class="flex items-center justify-between mb-1">
                                        <span class="font-semibold text-foreground">@(package?.Name ?? sub.PackageId)</span>
                                        <span class="rounded-full px-2.5 py-0.5 text-xs font-semibold @(sub.Status == "Active" ? "bg-success-500/15 text-success-600" : "bg-neutral-100 text-neutral-500")">@sub.Status</span>
                                    </div>
                                    <p class="text-xs text-neutral-400">Since @sub.StartDate.ToLocalTime().ToString("MMM d, yyyy")@(sub.NextBillingDate.HasValue ? $" \u00b7 renews {sub.NextBillingDate.Value.ToLocalTime():MMM d, yyyy}" : "")</p>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </section>
        }
    </div>
</main>
